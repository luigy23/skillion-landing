{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/es",
      "destination": "/es/",
      "permanent": true
    },
    {
      "source": "/gracias/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.skillion.app"
        }
      ],
      "destination": "https://skillion.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml"
    },
    {
      "source": "/p/:code",
      "destination": "/api/pact-link?code=:code"
    },
    {
      "source": "/p/:code/",
      "destination": "/api/pact-link?code=:code"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
