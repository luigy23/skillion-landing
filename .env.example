# MailerLite API Configuration
# Obtén tu API key en: https://dashboard.mailerlite.com/integrations/api
MAILERLITE_API_KEY=your_mailerlite_api_key_here

# ID del grupo al que se agregarán los suscriptores (opcional)
# Si no especificas un grupo, los suscriptores se agregarán sin grupo
MAILERLITE_GROUP_ID=your_group_id_here

# Blog: los posts se leen de Neon en tiempo de build (src/lib/blog-loader.ts).
# Sin esta variable `npm run build` falla a propósito, para no publicar un
# índice vacío. Va entre comillas dobles: scripts/dump-posts.mjs la lee del
# .env con una expresión regular que las exige.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Google Analytics 4. Solo se emite en builds de producción (import.meta.env.PROD);
# en `astro dev` no se carga.
PUBLIC_GA_ID=G-XXXXXXXXXX
