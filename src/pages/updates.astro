---
import Layout from '../layouts/Layout.astro';
import ChangelogPage from '../components/ChangelogPage.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { changelogUi } from '../data/changelog';
---

<Layout
  lang="en"
  title={changelogUi.metaTitle.en}
  description={changelogUi.metaDescription.en}
  showLanguageSwitcher={false}
  background="#0f1526"
>
  <ChangelogPage lang="en" />
  <SiteFooter lang="en" />
</Layout>
