---
import '../styles/global.css';
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";

import { ClientRouter } from 'astro:transitions';
import { getAlternates, type Alternates } from '../lib/i18n';
import { organization, serializeGraph, ORG_ID, SAME_AS } from '../lib/schema';

export interface Props {
	title: string;
	description?: string;
	/** Ruta de la imagen OG. Se convierte a absoluta aquí. */
	ogImage?: string;
	lang?: string;
	/**
	 * Versiones EN/ES de esta página. Por defecto se deducen de la ruta; los
	 * artículos del blog las pasan a mano porque sus slugs viven en Neon y no
	 * se pueden calcular. `null` = la página no tiene equivalente y no emite
	 * hreflang.
	 */
	alternates?: Alternates | null;
	/** El blog trae su propio selector EN/ES en la nav; evita duplicarlo. */
	showLanguageSwitcher?: boolean;
	/** Deja fuera del índice páginas como /gracias. */
	noindex?: boolean;
	/**
	 * Color de lienzo de la página.
	 *
	 * Va en línea sobre <html> a propósito: es lo primero que pinta el
	 * navegador, antes de que llegue ninguna hoja de estilos. Si el fondo vive
	 * solo en un div (como el #0f1526 del blog), al navegar entre páginas se
	 * ve un destello blanco —el lienzo por defecto— hasta que carga el CSS.
	 */
	background?: string;
	/**
	 * Navegación por cliente con transiciones (View Transitions).
	 *
	 * La regla: la monta TODA página de contenido —blog, concurso, novedades—
	 * porque entre ellas el router cambia el DOM sin recargar y el fundido sale
	 * limpio. La landing queda fuera a propósito: su parallax vive en scripts
	 * de módulo que se ejecutan una vez al cargar, y con el router no se
	 * volverían a ejecutar al entrar.
	 *
	 * Cuidado al añadir una página nueva a la nav: si se olvida esta prop, el
	 * router de la página de origen intercepta el clic, ve que el destino no lo
	 * lleva y cae a recarga dura. El fundido desaparece justo en esa pareja de
	 * páginas y en ninguna otra, que es un bicho incómodo de ver. Si la página
	 * necesita carga completa, entonces los enlaces que van hacia ella llevan
	 * `data-astro-reload` para que la navegación sea normal desde el principio
	 * y el fundido lo ponga la regla nativa de global.css.
	 */
	clientRouter?: boolean;
}

const {
	title,
	description = "Skillion - La app que gamifica tu vida real. Convierte tus hábitos en un RPG, gana XP por cada tarea completada y sube de nivel en la vida real. Descarga la app de gamificación de hábitos más divertida.",
	ogImage = "/og/skillion.png",
	lang = "es",
	alternates,
	showLanguageSwitcher = true,
	noindex = false,
	background,
	clientRouter = false,
} = Astro.props;

const isSpanish = (lang === 'es');

// og:image y twitter:image exigen URL ABSOLUTA. Antes se emitía
// "/assets/Skillion.png": ruta relativa y, además, un fichero que no existe en
// dist, así que ninguna página tenía imagen al compartirse.
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;

// Los hreflang se calculan por ruta. Antes eran fijos al home: en /contact se
// declaraba que la versión española era /es/.
const alts = alternates === undefined ? getAlternates(Astro.url.pathname) : alternates;

// El sitio se compila en formato "directorio": cada página se sirve en una URL
// con barra final, y eso es lo que dicen la canónica y el sitemap. Los
// hreflang tienen que apuntar EXACTAMENTE a esa misma URL — si unos llevan
// barra y otros no, Google los ve como URLs distintas y no empareja los
// idiomas, que es justo lo que se pretende con ellos.
const withSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);

const urlEn = alts ? new URL(withSlash(alts.en), Astro.site ?? Astro.url).href : null;
const urlEs = alts ? new URL(withSlash(alts.es), Astro.site ?? Astro.url).href : null;

// La canónica sale del sitio configurado, no de Astro.url: en build local
// Astro.url apunta a localhost y se colaba en el HTML publicado.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// El SoftwareApplication describe la APP, no la página. Emitirlo en las 25
// páginas le decía a los buscadores y a los modelos que la entidad principal de
// un artículo del blog es la app, compitiendo con el BlogPosting del propio
// artículo. Se queda solo donde es cierto: la portada.
const isHome = ['/', '/es', '/es/'].includes(Astro.url.pathname);

// Los dos grafos van en un solo @graph para poder referenciarse entre sí por
// @id: la app la publica la organización, y así se declara una vez y no dos
// entidades sueltas que casualmente se llaman igual.
const siteBase = Astro.site ?? new URL('https://skillion.app');
const absUrl = (path: string) => new URL(path, siteBase).href;

const homeGraph = {
	'@context': 'https://schema.org',
	'@graph': [
		organization(absUrl),
		{
			'@type': 'SoftwareApplication',
			'@id': absUrl('/#app'),
			name: 'Skillion',
			description:
				'App de gamificación que convierte tus hábitos y metas en una aventura RPG. Gana XP en la vida real por cada tarea que completas.',
			url: absUrl('/'),
			applicationCategory: 'ProductivityApplication',
			operatingSystem: 'iOS, Android',
			offers: {
				'@type': 'Offer',
				price: '0',
				priceCurrency: 'USD',
			},
			// Las fichas de tienda son la misma app en otro sitio: es lo que
			// permite atar lo que se dice aquí con lo que hay publicado allí.
			sameAs: SAME_AS.filter((url) => url.includes('apple.com') || url.includes('play.google')),
			downloadUrl: SAME_AS.filter((url) => url.includes('apple.com') || url.includes('play.google')),
			publisher: { '@id': ORG_ID },
			creator: { '@id': ORG_ID },
			keywords:
				'gamificación, hábitos, productividad, RPG, XP, vida real, motivación, metas',
		},
	],
};
---

<!doctype html>
<html lang={lang} style={background ? `background-color:${background};color-scheme:dark` : undefined}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{/* Iconos generados por scripts/make-icons.mjs desde el maestro de
		    src/assets/brand/. El favicon era antes ese maestro tal cual: 1000x1000
		    y 256 KB descargados en cada carga para dibujarse a 16 px. */}
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		{clientRouter && <ClientRouter />}
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Skillion Team" />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:site_name" content="Skillion" />
		<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

		<!-- Hreflang alternates: calculados por ruta (ver src/lib/i18n.ts) -->
		{urlEs && <link rel="alternate" hreflang="es" href={urlEs} />}
		{urlEs && <link rel="alternate" hreflang="es-ES" href={urlEs} />}
		{urlEn && <link rel="alternate" hreflang="en" href={urlEn} />}
		{urlEn && <link rel="alternate" hreflang="en-US" href={urlEn} />}
		{urlEn && <link rel="alternate" hreflang="x-default" href={urlEn} />}

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonical} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImageUrl} />
		<meta property="twitter:creator" content="@skillion_app" />
		
		<!-- Additional SEO -->
		<meta name="theme-color" content="#90c5bf" />
		<meta name="application-name" content="Skillion" />
		<meta name="apple-mobile-web-app-title" content="Skillion" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		
		{/* Describe la ORGANIZACIÓN y la APP. Solo en la portada: ver isHome
		    arriba.

		    Sin aggregateRating: declaraba 4.8 sobre 1000 valoraciones sin
		    respaldo en las tiendas, y el marcado de reseñas sin datos reales
		    es motivo de penalizacion manual de Google.

		    El Organization con sameAs es lo que permite a un buscador
		    reconocer que la cuenta de TikTok, las dos de Instagram y las dos
		    fichas de tienda son la misma entidad que esta web. Sin eso somos
		    cinco perfiles sin relación entre sí. */}
		{isHome && (
			<script type="application/ld+json" set:html={serializeGraph(homeGraph)} />
		)}
		
	<!-- Poppins se autoaloja y se declara en global.css. Se precargan los dos
	     pesos que pinta cualquier pagina desde el primer frame; los demas los
	     pide el navegador cuando los necesita. -->
	<link rel="preload" href="/fonts/Poppins-Regular.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="/fonts/Poppins-Bold.woff2" as="font" type="font/woff2" crossorigin>
	
	<!-- VT323 + Press Start 2P + Nunito loaded asynchronously (non-blocking) -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=VT323&family=Press+Start+2P&family=Nunito:wght@400;700;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
	<noscript><link href="https://fonts.googleapis.com/css2?family=VT323&family=Press+Start+2P&family=Nunito:wght@400;700;900&display=swap" rel="stylesheet"></noscript>
	</head>
	<body class="font-poppins">
		<GoogleAnalytics />
		<Analytics />
		<SpeedInsights />

		<!-- Language Switcher. El blog lo apaga: su nav ya trae uno propio y si
		     no, salen dos selectores de idioma superpuestos. El script de abajo
		     sale solo si no encuentra el elemento. -->
		{showLanguageSwitcher && (
		<nav class="fixed top-3 right-3 z-50 pointer-events-auto">
			<select
				id="language-selector"
				class="bg-gray-900/80 backdrop-blur-sm text-white text-sm font-poppins border-2 border-gaming-gold rounded px-3 py-1 outline-none cursor-pointer hover:bg-gray-800/90 transition-colors"
				aria-label="Select language"
			>
				<option value="en" selected={!isSpanish}>🇺🇸 EN</option>
				<option value="es" selected={isSpanish}>🇪🇸 ES</option>
			</select>
		</nav>
		)}

		<script>
		  (function(){
			try {
			  var select = document.getElementById('language-selector') as HTMLSelectElement;
			  if (!select) return;
			  
			  // Get current path and determine language
			  var currentPath = window.location.pathname;
			  var isEsPath = currentPath.startsWith('/es/') || currentPath === '/es';
			  
			  // Set correct selection on page load
			  select.value = isEsPath ? 'es' : 'en';
			  
			  select.addEventListener('change', function(e){
				var target = e.target as HTMLSelectElement;
				if (!target) return;
				var selectedLang = target.value;
				
				// Save preference
				try { 
				  localStorage.setItem('preferredLang', selectedLang); 
				} catch(err) {}
				
				// Determine target URL based on current path
				var targetUrl = '/';
				
				// Get the path without /es/ prefix
				var pathWithoutLang = currentPath.replace(/^\/es\//, '/').replace(/^\/es$/, '/');
				
				if (selectedLang === 'es') {
				  // Going to Spanish version
				  if (pathWithoutLang === '/') {
					targetUrl = '/es/';
				  } else {
					targetUrl = '/es' + pathWithoutLang;
				  }
				} else {
				  // Going to English version
				  targetUrl = pathWithoutLang;
				}
				
				window.location.href = targetUrl;
			  });
			} catch(e) {}
		  })();
		</script>

		<slot />
	</body>
</html>
