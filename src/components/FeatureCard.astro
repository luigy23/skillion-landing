---
interface Props {
  title?: string;
  /** Icono pixel art importado desde src/assets. */
  icon?: ImageMetadata;
  iconAlt?: string;
  /** Ancho del icono en px dentro del marco de 76px. */
  iconWidth?: number;
  class?: string;
  description?: string;
}

const {
  title,
  icon,
  iconAlt = '',
  iconWidth = 52,
  class: className,
  description,
} = Astro.props;

// El icono se sirve SIN pasar por <Image>: sharp resamplea con interpolación
// suave y destruye la rejilla del pixel art (checklist 23x22 -> 52x50 borroso).
// Enviamos el original y el navegador escala con nearest-neighbor vía
// image-rendering: pixelated. Mismo criterio que ParallaxHero.
const iconHeight = icon
  ? Math.round(iconWidth * (icon.height / icon.width))
  : undefined;
---

<div class={`feature-card ${className || ''}`}>
  {icon && (
    <div class="icon-frame">
      <img
        src={icon.src}
        alt={iconAlt}
        width={iconWidth}
        height={iconHeight}
        class="icon-image"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  {title && <h3 class="card-title">{title}</h3>}
  <div class="card-content">
    {description ? <p>{description}</p> : <slot />}
  </div>
  <slot name="extra" />
</div>

<style>
  /* Card de madera pixel art — specs del rediseño (artboard 1a) */
  .feature-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 26px 22px 28px;
    text-align: center;
    background: #7b5433;
    border: 4px solid #2b1a0c;
    border-radius: 0;
    box-shadow:
      inset 0 0 0 4px #a9784a,
      8px 8px 0 0 rgba(20, 10, 0, 0.35);
    color: #f0dcc4;
    font-family: 'Nunito', 'Poppins', sans-serif;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow:
      inset 0 0 0 4px #a9784a,
      12px 12px 0 0 rgba(20, 10, 0, 0.42);
  }

  .icon-frame {
    display: grid;
    place-items: center;
    flex: none;
    width: 76px;
    height: 76px;
    background: #2b1a0c;
    border: 3px solid #a9784a;
  }

  .icon-image {
    height: auto;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .card-title {
    margin: 0;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 12px;
    line-height: 1.6;
    color: #ffe6a0;
    text-wrap: balance;
  }

  .card-content {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.5;
    color: #f0dcc4;
    text-wrap: pretty;
  }

  .card-content :global(p) {
    margin: 0;
  }

  /* En móvil el titular pixel necesita algo menos de cuerpo para no romper */
  @media (max-width: 400px) {
    .card-title {
      font-size: 11px;
    }
  }
</style>
