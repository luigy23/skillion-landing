---
import SiteNav from './SiteNav.astro';
import ChangelogTimeline from './ChangelogTimeline.astro';
import { changelogUi, type Lang } from '../data/changelog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const homeHref = lang === 'es' ? '/es/' : '/';
const altHref = lang === 'es' ? '/updates' : '/es/novedades';
---

<SiteNav lang={lang} altHref={altHref} section="updates" isCurrent />

<main class="changelog-page">
  <!-- Hero -->
  <section class="changelog-hero">
    <p class="hero-eyebrow">{changelogUi.heroEyebrow[lang]}</p>
    <h1 class="hero-title">{changelogUi.heroTitle[lang]}</h1>
    <p class="hero-subtitle">{changelogUi.heroSubtitle[lang]}</p>
  </section>

  <!-- Timeline -->
  <section class="changelog-body">
    <ChangelogTimeline lang={lang} />
  </section>

  <!-- Cierre -->
  <section class="changelog-outro">
    <div class="outro-card">
      <h2 class="outro-title">{changelogUi.thanksTitle[lang]}</h2>
      <p class="outro-text">{changelogUi.thanksText[lang]}</p>
      {/* data-astro-reload: vuelve a la landing, que necesita carga completa
          para que arranquen sus scripts de parallax. */}
      <a href={homeHref} class="outro-cta" data-astro-reload>
        {changelogUi.backHome[lang]}
      </a>
    </div>
  </section>
</main>

<style>
  .changelog-page {
    background: #0f1526;
    color: #c9d6f5;
    font-family: 'Nunito', 'Poppins', sans-serif;
  }

  /* ---------- HERO ---------- */
  .changelog-hero {
    padding: 72px 24px 48px;
    text-align: center;
    background: linear-gradient(#141b32 0%, #0f1526 100%);
    border-bottom: 4px solid #1b2547;
  }

  .hero-eyebrow {
    margin: 0 0 18px;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: 0.1em;
    color: #8fe3da;
    text-transform: uppercase;
  }

  .hero-title {
    margin: 0 0 20px;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: clamp(18px, 4vw, 34px);
    line-height: 1.5;
    color: #ffe6a0;
    text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.45);
    text-wrap: balance;
  }

  .hero-subtitle {
    margin: 0 auto;
    max-width: 560px;
    font-size: clamp(15px, 2.2vw, 18px);
    font-weight: 700;
    line-height: 1.55;
    color: #8fa6dd;
    text-wrap: pretty;
  }

  /* ---------- CUERPO ---------- */
  .changelog-body {
    max-width: 56rem;
    margin: 0 auto;
    padding: 56px 24px;
  }

  /* ---------- CIERRE ---------- */
  .changelog-outro {
    padding: 0 24px 72px;
  }

  .outro-card {
    max-width: 40rem;
    margin: 0 auto;
    padding: 34px 30px 36px;
    text-align: center;
    background: #1b2547;
    border: 4px solid #0a0f1f;
    box-shadow:
      inset 0 0 0 4px #ffc53d,
      10px 10px 0 0 rgba(5, 8, 18, 0.5);
  }

  .outro-title {
    margin: 0 0 14px;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: clamp(12px, 2vw, 16px);
    line-height: 1.6;
    color: #ffe6a0;
    text-wrap: balance;
  }

  .outro-text {
    margin: 0 0 24px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.55;
    color: #c9d6f5;
    text-wrap: pretty;
  }

  .outro-cta {
    display: inline-flex;
    align-items: center;
    padding: 15px 20px;
    background: #ffc53d;
    color: #2a1a06;
    border: 4px solid #0a0f1f;
    box-shadow:
      inset -4px -4px 0 0 #c98a12,
      inset 4px 4px 0 0 #ffe6a0,
      6px 6px 0 0 rgba(5, 8, 18, 0.45);
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: clamp(9px, 1.4vw, 11px);
    line-height: 1.5;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .outro-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow:
      inset -4px -4px 0 0 #c98a12,
      inset 4px 4px 0 0 #ffe6a0,
      8px 8px 0 0 rgba(5, 8, 18, 0.5);
  }

  @media (max-width: 640px) {
    .changelog-hero {
      padding: 52px 20px 40px;
    }

    .changelog-body {
      padding: 40px 20px;
    }

    .changelog-outro {
      padding: 0 20px 52px;
    }
  }
</style>
