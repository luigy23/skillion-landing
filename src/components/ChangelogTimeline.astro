---
import {
  changelog,
  changelogUi,
  formatDate,
  type Lang,
  type ChangelogTag,
} from '../data/changelog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Cuántas versiones se ven de entrada. El resto llegan de tres en tres con el
// botón: el historial sólo crece, y sin esto la página se haría infinita.
const PAGE_SIZE = 3;

// Mismo código de color que las categorías del blog, para que un chip
// signifique lo mismo en todo el sitio.
const tagClass: Record<ChangelogTag, string> = {
  feature: 'tag tag--feature',
  fix: 'tag tag--fix',
  improvement: 'tag tag--improvement',
};
---

<div class="timeline">
  <div class="timeline-line" aria-hidden="true"></div>

  <ol class="release-list">
    {
      changelog.map((release, index) => (
        <li class="release" hidden={index >= PAGE_SIZE}>
          <div
            class:list={['release-node', release.highlight ? 'release-node--latest' : '']}
            aria-hidden="true"
          >
            {release.highlight ? '★' : '▸'}
          </div>

          <article class="release-card">
            <header class="release-head">
              <span class="release-version">
                <span class="release-version__label">{changelogUi.versionLabel[lang]}</span>
                v{release.version}
              </span>

              {release.codename && (
                <span class="release-codename">{release.codename[lang]}</span>
              )}

              {release.highlight && (
                <span class="release-latest">{changelogUi.latestBadge[lang]}</span>
              )}

              <time datetime={release.date} class="release-date">
                {formatDate(release.date, lang)}
              </time>
            </header>

            <ul class="entry-list">
              {release.entries.map((entry) => (
                <li class="entry">
                  <div class="entry-icon" aria-hidden="true">{entry.icon}</div>

                  <div class="entry-body">
                    <div class="entry-head">
                      <h3 class="entry-title">{entry.title[lang]}</h3>
                      <span class={tagClass[entry.tag]}>
                        {changelogUi.tags[entry.tag][lang]}
                      </span>
                    </div>
                    <p class="entry-text">{entry.description[lang]}</p>
                  </div>
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>

  {
    changelog.length > PAGE_SIZE && (
      <div class="show-more-row">
        <button
          type="button"
          class="show-more"
          id="changelog-show-more"
          data-page-size={PAGE_SIZE}
        >
          {changelogUi.showMore[lang]}
        </button>
      </div>
    )
  }
</div>

<script>
  function initShowMore() {
    const button = document.getElementById('changelog-show-more') as HTMLButtonElement | null;
    if (!button) return;
    // Con el ClientRouter esto corre en la carga inicial Y en cada
    // astro:page-load. Sin la marca, volver a la página engancharía un segundo
    // listener y cada clic revelaría el doble de versiones.
    if (button.dataset.bound === 'true') return;
    button.dataset.bound = 'true';

    const releases = Array.from(document.querySelectorAll<HTMLElement>('.release'));
    const pageSize = Number(button.dataset.pageSize) || 3;
    let visible = pageSize;

    button.addEventListener('click', () => {
      visible += pageSize;
      releases.forEach((release, index) => {
        release.hidden = index >= visible;
      });
      if (visible >= releases.length) button.hidden = true;
    });
  }

  initShowMore();
  document.addEventListener('astro:page-load', initShowMore);
</script>

<style>
  .timeline {
    position: relative;
  }

  .timeline-line {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 17px;
    width: 4px;
    background: linear-gradient(180deg, #ffc53d 0%, #3f5da8 40%, transparent 100%);
  }

  .release-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* El raíl y el nodo ocupan 58px a la izquierda. Sin el mismo hueco a la
     derecha la tarjeta queda corrida: se ve descentrada respecto a la página
     aunque el contenedor sí esté centrado. */
  .release {
    position: relative;
    padding-left: 58px;
    padding-right: 58px;
  }

  /* Nodo cuadrado, no circular: el redondeo desentona con el resto del pixel art */
  .release-node {
    position: absolute;
    left: 0;
    top: 6px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    background: #1b2547;
    border: 4px solid #0a0f1f;
    box-shadow: inset 0 0 0 3px #3f5da8;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 12px;
    line-height: 1;
    color: #8fa6dd;
  }

  .release-node--latest {
    box-shadow: inset 0 0 0 3px #ffc53d;
    color: #ffc53d;
  }

  .release-card {
    background: #1b2547;
    border: 4px solid #0a0f1f;
    box-shadow: 8px 8px 0 0 rgba(5, 8, 18, 0.45);
  }

  /* ---------- CABECERA DE VERSIÓN ---------- */
  .release-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 16px 20px;
    background: #141b32;
    border-bottom: 4px solid #0a0f1f;
  }

  .release-version {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 8px 10px;
    background: #0f1730;
    border: 3px solid #3f5da8;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 11px;
    line-height: 1.4;
    color: #ffe6a0;
  }

  /* Sin text-transform a proposito: la etiqueta va en Press Start 2P y en
     español dice "Versión". En mayúsculas la Ó no existe en esa fuente y el
     navegador la sacaba de otra, más grande y descuadrada. En minúsculas
     sí está, así que se respeta el texto tal cual viene. */
  .release-version__label {
    font-size: 8px;
    letter-spacing: 0.08em;
    color: #8fa6dd;
  }

  /* Press Start 2P tiene un único grosor: con font-weight 900 el navegador
     falsea la negrita y emborrona los píxeles. */
  .release-codename {
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 11px;
    font-weight: 400;
    line-height: 1.6;
    color: #8fe3da;
  }

  .release-latest {
    padding: 7px 9px;
    background: #ffc53d;
    color: #2a1a06;
    border: 3px solid #0a0f1f;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 8px;
    line-height: 1;
  }

  /* 9px: es metadato, va por debajo de la versión y del nombre (11px). El
     peso vuelve a 400 porque Press Start 2P sólo tiene un grosor. Los meses
     en español no llevan tilde, así que no hay riesgo de glifo ausente. */
  .release-date {
    margin-left: auto;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 9px;
    font-weight: 400;
    line-height: 1.6;
    color: #8fa6dd;
  }

  /* ---------- ENTRADAS ---------- */
  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    display: flex;
    gap: 16px;
    padding: 18px 20px;
  }

  .entry + .entry {
    border-top: 3px solid #243157;
  }

  .entry-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    background: #0f1730;
    border: 3px solid #3f5da8;
    font-size: 22px;
    line-height: 1;
  }

  .entry-body {
    min-width: 0;
    flex: 1;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .entry-title {
    margin: 0;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 11px;
    line-height: 1.6;
    color: #ffe6a0;
    text-wrap: balance;
  }

  .entry-text {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.55;
    color: #c9d6f5;
    text-wrap: pretty;
  }

  /* ---------- CHIPS ---------- */
  .tag {
    flex: none;
    padding: 6px 8px;
    border: 3px solid #0a0f1f;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 8px;
    line-height: 1;
  }

  .tag--feature {
    background: #8fe3da;
    color: #0a2b28;
  }

  .tag--fix {
    background: #b58fe3;
    color: #1b0f2b;
  }

  .tag--improvement {
    background: #ffc53d;
    color: #2a1a06;
  }

  .show-more-row {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  .show-more {
    padding: 15px 20px;
    background: #1b2547;
    border: 4px solid #0a0f1f;
    box-shadow: inset 0 0 0 3px #3f5da8;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 10px;
    line-height: 1.5;
    color: #dceafe;
    cursor: pointer;
  }

  .show-more:hover,
  .show-more:focus-visible {
    color: #ffffff;
  }

  .show-more[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .release {
      padding-left: 46px;
      /* En móvil el ancho escasea: se recupera el hueco de la derecha y se
         acepta el pequeño descentrado, que a esta anchura no se nota. */
      padding-right: 0;
    }

    .timeline-line {
      left: 13px;
    }

    .release-node {
      width: 30px;
      height: 30px;
      font-size: 10px;
    }

    .entry {
      padding: 16px;
    }

    .entry-icon {
      width: 38px;
      height: 38px;
      font-size: 18px;
    }

    .release-date {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
