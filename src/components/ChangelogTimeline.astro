---
import {
  changelog,
  changelogUi,
  formatDate,
  type Lang,
  type ChangelogTag,
} from '../data/changelog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Mismo código de color que las categorías del blog, para que un chip
// signifique lo mismo en todo el sitio.
const tagClass: Record<ChangelogTag, string> = {
  feature: 'tag tag--feature',
  fix: 'tag tag--fix',
  improvement: 'tag tag--improvement',
};
---

<div class="timeline">
  <div class="timeline-line" aria-hidden="true"></div>

  <ol class="release-list">
    {
      changelog.map((release) => (
        <li class="release">
          <div
            class:list={['release-node', release.highlight ? 'release-node--latest' : '']}
            aria-hidden="true"
          >
            {release.highlight ? '★' : '▸'}
          </div>

          <article class="release-card">
            <header class="release-head">
              <span class="release-version">
                <span class="release-version__label">{changelogUi.versionLabel[lang]}</span>
                v{release.version}
              </span>

              {release.codename && (
                <span class="release-codename">{release.codename[lang]}</span>
              )}

              {release.highlight && (
                <span class="release-latest">{changelogUi.latestBadge[lang]}</span>
              )}

              <time datetime={release.date} class="release-date">
                {formatDate(release.date, lang)}
              </time>
            </header>

            <ul class="entry-list">
              {release.entries.map((entry) => (
                <li class="entry">
                  <div class="entry-icon" aria-hidden="true">{entry.icon}</div>

                  <div class="entry-body">
                    <div class="entry-head">
                      <h3 class="entry-title">{entry.title[lang]}</h3>
                      <span class={tagClass[entry.tag]}>
                        {changelogUi.tags[entry.tag][lang]}
                      </span>
                    </div>
                    <p class="entry-text">{entry.description[lang]}</p>
                  </div>
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .timeline {
    position: relative;
  }

  .timeline-line {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 17px;
    width: 4px;
    background: linear-gradient(180deg, #ffc53d 0%, #3f5da8 40%, transparent 100%);
  }

  .release-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .release {
    position: relative;
    padding-left: 58px;
  }

  /* Nodo cuadrado, no circular: el redondeo desentona con el resto del pixel art */
  .release-node {
    position: absolute;
    left: 0;
    top: 6px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    background: #1b2547;
    border: 4px solid #0a0f1f;
    box-shadow: inset 0 0 0 3px #3f5da8;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 12px;
    line-height: 1;
    color: #8fa6dd;
  }

  .release-node--latest {
    box-shadow: inset 0 0 0 3px #ffc53d;
    color: #ffc53d;
  }

  .release-card {
    background: #1b2547;
    border: 4px solid #0a0f1f;
    box-shadow: 8px 8px 0 0 rgba(5, 8, 18, 0.45);
  }

  /* ---------- CABECERA DE VERSIÓN ---------- */
  .release-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 16px 20px;
    background: #141b32;
    border-bottom: 4px solid #0a0f1f;
  }

  .release-version {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 8px 10px;
    background: #0f1730;
    border: 3px solid #3f5da8;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 11px;
    line-height: 1.4;
    color: #ffe6a0;
  }

  .release-version__label {
    font-size: 8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8fa6dd;
  }

  .release-codename {
    font-size: 15px;
    font-weight: 900;
    color: #8fe3da;
  }

  .release-latest {
    padding: 7px 9px;
    background: #ffc53d;
    color: #2a1a06;
    border: 3px solid #0a0f1f;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 8px;
    line-height: 1;
  }

  .release-date {
    margin-left: auto;
    font-size: 13px;
    font-weight: 700;
    color: #8fa6dd;
  }

  /* ---------- ENTRADAS ---------- */
  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    display: flex;
    gap: 16px;
    padding: 18px 20px;
  }

  .entry + .entry {
    border-top: 3px solid #243157;
  }

  .entry-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    background: #0f1730;
    border: 3px solid #3f5da8;
    font-size: 22px;
    line-height: 1;
  }

  .entry-body {
    min-width: 0;
    flex: 1;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .entry-title {
    margin: 0;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 11px;
    line-height: 1.6;
    color: #ffe6a0;
    text-wrap: balance;
  }

  .entry-text {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.55;
    color: #c9d6f5;
    text-wrap: pretty;
  }

  /* ---------- CHIPS ---------- */
  .tag {
    flex: none;
    padding: 6px 8px;
    border: 3px solid #0a0f1f;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 8px;
    line-height: 1;
  }

  .tag--feature {
    background: #8fe3da;
    color: #0a2b28;
  }

  .tag--fix {
    background: #b58fe3;
    color: #1b0f2b;
  }

  .tag--improvement {
    background: #ffc53d;
    color: #2a1a06;
  }

  @media (max-width: 640px) {
    .release {
      padding-left: 46px;
    }

    .timeline-line {
      left: 13px;
    }

    .release-node {
      width: 30px;
      height: 30px;
      font-size: 10px;
    }

    .entry {
      padding: 16px;
    }

    .entry-icon {
      width: 38px;
      height: 38px;
      font-size: 18px;
    }

    .release-date {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
