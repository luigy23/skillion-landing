---
import {
  changelog,
  changelogUi,
  formatDate,
  type Lang,
  type ChangelogTag,
} from '../data/changelog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Cuántas versiones se ven de entrada. El resto llegan de tres en tres con el
// botón: el historial sólo crece, y sin esto la página se haría infinita.
const PAGE_SIZE = 3;

// Mismo código de color que las categorías del blog, para que un chip
// signifique lo mismo en todo el sitio.
const tagClass: Record<ChangelogTag, string> = {
  feature: 'tag tag--feature',
  fix: 'tag tag--fix',
  improvement: 'tag tag--improvement',
};

// ---------- SKIN DE HALLOWEEN ----------
// Copia del marco del modal de novedades de la app para la 2.12.0
// (skillapp: lib/modules/changelog/presentation/widgets/halloween/). Los
// números salen de allí; si la app lo cambia, se cambia aquí.

// La telaraña de la esquina: siete radios que bajan del vértice superior
// derecho hacia la izquierda y cinco anillos que se comban entre ellos.
// Mismo cálculo que _CobwebPainter, en un lienzo de 132 × 132.
const cobwebPath = (() => {
  const spokes = 7;
  const rings = [26, 50, 76, 104, 130];
  const angle = (i: number) => Math.PI / 2 + (Math.PI / 2) * (i / (spokes - 1));
  const at = (r: number, i: number) =>
    `${(132 + Math.cos(angle(i)) * r).toFixed(1)} ${(Math.sin(angle(i)) * r).toFixed(1)}`;
  const parts: string[] = [];
  for (let i = 0; i < spokes; i++) parts.push(`M132 0L${at(rings[rings.length - 1] + 6, i)}`);
  for (const r of rings) {
    for (let i = 0; i < spokes - 1; i++) {
      parts.push(`M${at(r, i)}Q${at(r * 0.86, i + 0.5)} ${at(r, i + 1)}`);
    }
  }
  return parts.join('');
})();

// La araña en una rejilla de 11 × 9 píxeles: [x, y, ancho, alto, color].
const spiderPixels: [number, number, number, number, string][] = [
  [4, 1, 3, 2, '#2b1850'],
  [3, 3, 5, 4, '#2b1850'],
  [4, 7, 3, 1, '#2b1850'],
  [1, 2, 2, 1, '#2b1850'],
  [0, 3, 1, 2, '#2b1850'],
  [1, 5, 2, 1, '#2b1850'],
  [0, 6, 1, 2, '#2b1850'],
  [8, 2, 2, 1, '#2b1850'],
  [10, 3, 1, 2, '#2b1850'],
  [8, 5, 2, 1, '#2b1850'],
  [10, 6, 1, 2, '#2b1850'],
  [4, 4, 1, 1, '#ff7700'],
  [6, 4, 1, 1, '#ff7700'],
  [3, 3, 5, 1, '#2f1a55'],
];

// Los tres que asoman por encima del borde, en el orden del banner.
const peekers = ['vampire_male', 'mummy_female', 'pirate_female'];
---

<div class="timeline">
  <div class="timeline-line" aria-hidden="true"></div>

  <ol class="release-list">
    {
      changelog.map((release, index) => (
        <li
          class:list={['release', release.skin && `release--${release.skin}`]}
          hidden={index >= PAGE_SIZE}
        >
          <div
            class:list={[
              'release-node',
              release.highlight && 'release-node--latest',
              release.skin && `release-node--${release.skin}`,
            ]}
            aria-hidden="true"
          >
            {release.highlight ? '★' : '▸'}
          </div>

          {release.skin === 'halloween' && (
            <div class="hw-peekers" aria-hidden="true">
              {peekers.map((name) => (
                <img
                  class={`hw-peeker hw-peeker--${name}`}
                  src={`/images/changelog/halloween-2026/${name}.png`}
                  alt=""
                  width="384"
                  height="384"
                  decoding="async"
                />
              ))}
            </div>
          )}

          <article class:list={['release-card', release.skin && `release-card--${release.skin}`]}>
            {release.skin === 'halloween' && (
              <div class="hw-decor" aria-hidden="true">
                <div class="hw-glow" />
                <div class="hw-beam" />
                <svg class="hw-cobweb" viewBox="0 0 132 132" width="132" height="132">
                  <path d={cobwebPath} />
                </svg>
                <div class="hw-spider">
                  <div class="hw-spider__thread" />
                  <svg viewBox="0 0 11 9" width="22" height="18" shape-rendering="crispEdges">
                    {spiderPixels.map(([x, y, w, h, fill]) => (
                      <rect x={x} y={y} width={w} height={h} fill={fill} />
                    ))}
                  </svg>
                </div>
              </div>
            )}

            <header class="release-head">
              <span class="release-version">
                <span class="release-version__label">{changelogUi.versionLabel[lang]}</span>
                v{release.version}
              </span>

              {release.codename && (
                <span class="release-codename">{release.codename[lang]}</span>
              )}

              {release.highlight && (
                <span class="release-latest">{changelogUi.latestBadge[lang]}</span>
              )}

              <time datetime={release.date} class="release-date">
                {formatDate(release.date, lang)}
              </time>
            </header>

            <ul class="entry-list">
              {release.entries.map((entry) => (
                <li class="entry">
                  <div class="entry-icon" aria-hidden="true">{entry.icon}</div>

                  <div class="entry-body">
                    <div class="entry-head">
                      <h3 class="entry-title">{entry.title[lang]}</h3>
                      <span class={tagClass[entry.tag]}>
                        {changelogUi.tags[entry.tag][lang]}
                      </span>
                    </div>
                    <p class="entry-text">{entry.description[lang]}</p>
                  </div>
                </li>
              ))}
            </ul>

            {release.skin === 'halloween' && <div class="hw-ground" aria-hidden="true" />}
          </article>
        </li>
      ))
    }
  </ol>

  {
    changelog.length > PAGE_SIZE && (
      <div class="show-more-row">
        <button
          type="button"
          class="show-more"
          id="changelog-show-more"
          data-page-size={PAGE_SIZE}
        >
          {changelogUi.showMore[lang]}
        </button>
      </div>
    )
  }
</div>

<script>
  function initShowMore() {
    const button = document.getElementById('changelog-show-more') as HTMLButtonElement | null;
    if (!button) return;
    // Con el ClientRouter esto corre en la carga inicial Y en cada
    // astro:page-load. Sin la marca, volver a la página engancharía un segundo
    // listener y cada clic revelaría el doble de versiones.
    if (button.dataset.bound === 'true') return;
    button.dataset.bound = 'true';

    const releases = Array.from(document.querySelectorAll<HTMLElement>('.release'));
    const pageSize = Number(button.dataset.pageSize) || 3;
    let visible = pageSize;

    button.addEventListener('click', () => {
      visible += pageSize;
      releases.forEach((release, index) => {
        release.hidden = index >= visible;
      });
      if (visible >= releases.length) button.hidden = true;
    });
  }

  initShowMore();
  document.addEventListener('astro:page-load', initShowMore);
</script>

<style>
  .timeline {
    position: relative;
  }

  .timeline-line {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 17px;
    width: 4px;
    background: linear-gradient(180deg, #ffc53d 0%, #3f5da8 40%, transparent 100%);
  }

  .release-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* El raíl y el nodo ocupan 58px a la izquierda. Sin el mismo hueco a la
     derecha la tarjeta queda corrida: se ve descentrada respecto a la página
     aunque el contenedor sí esté centrado. */
  .release {
    position: relative;
    padding-left: 58px;
    padding-right: 58px;
  }

  /* Nodo cuadrado, no circular: el redondeo desentona con el resto del pixel art */
  .release-node {
    position: absolute;
    left: 0;
    top: 6px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    background: #1b2547;
    border: 4px solid #0a0f1f;
    box-shadow: inset 0 0 0 3px #3f5da8;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 12px;
    line-height: 1;
    color: #8fa6dd;
  }

  .release-node--latest {
    box-shadow: inset 0 0 0 3px #ffc53d;
    color: #ffc53d;
  }

  .release-card {
    background: #1b2547;
    border: 4px solid #0a0f1f;
    box-shadow: 8px 8px 0 0 rgba(5, 8, 18, 0.45);
  }

  /* ---------- CABECERA DE VERSIÓN ---------- */
  .release-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 16px 20px;
    background: #141b32;
    border-bottom: 4px solid #0a0f1f;
  }

  .release-version {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 8px 10px;
    background: #0f1730;
    border: 3px solid #3f5da8;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 11px;
    line-height: 1.4;
    color: #ffe6a0;
  }

  /* Sin text-transform a proposito: la etiqueta va en Press Start 2P y en
     español dice "Versión". En mayúsculas la Ó no existe en esa fuente y el
     navegador la sacaba de otra, más grande y descuadrada. En minúsculas
     sí está, así que se respeta el texto tal cual viene. */
  .release-version__label {
    font-size: 8px;
    letter-spacing: 0.08em;
    color: #8fa6dd;
  }

  /* Press Start 2P tiene un único grosor: con font-weight 900 el navegador
     falsea la negrita y emborrona los píxeles. */
  .release-codename {
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 11px;
    font-weight: 400;
    line-height: 1.6;
    color: #8fe3da;
  }

  .release-latest {
    padding: 7px 9px;
    background: #ffc53d;
    color: #2a1a06;
    border: 3px solid #0a0f1f;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 8px;
    line-height: 1;
  }

  /* 9px: es metadato, va por debajo de la versión y del nombre (11px). El
     peso vuelve a 400 porque Press Start 2P sólo tiene un grosor. Los meses
     en español no llevan tilde, así que no hay riesgo de glifo ausente. */
  .release-date {
    margin-left: auto;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 9px;
    font-weight: 400;
    line-height: 1.6;
    color: #8fa6dd;
  }

  /* ---------- ENTRADAS ---------- */
  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    display: flex;
    gap: 16px;
    padding: 18px 20px;
  }

  .entry + .entry {
    border-top: 3px solid #243157;
  }

  .entry-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    background: #0f1730;
    border: 3px solid #3f5da8;
    font-size: 22px;
    line-height: 1;
  }

  .entry-body {
    min-width: 0;
    flex: 1;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .entry-title {
    margin: 0;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 11px;
    line-height: 1.6;
    color: #ffe6a0;
    text-wrap: balance;
  }

  .entry-text {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.55;
    color: #c9d6f5;
    text-wrap: pretty;
  }

  /* ---------- CHIPS ---------- */
  .tag {
    flex: none;
    padding: 6px 8px;
    border: 3px solid #0a0f1f;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 8px;
    line-height: 1;
  }

  .tag--feature {
    background: #8fe3da;
    color: #0a2b28;
  }

  .tag--fix {
    background: #b58fe3;
    color: #1b0f2b;
  }

  .tag--improvement {
    background: #ffc53d;
    color: #2a1a06;
  }

  .show-more-row {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  .show-more {
    padding: 15px 20px;
    background: #1b2547;
    border: 4px solid #0a0f1f;
    box-shadow: inset 0 0 0 3px #3f5da8;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 10px;
    line-height: 1.5;
    color: #dceafe;
    cursor: pointer;
  }

  .show-more:hover,
  .show-more:focus-visible {
    color: #ffffff;
  }

  .show-more[hidden] {
    display: none;
  }

  /* ---------- SKIN DE HALLOWEEN (2.12.0) ----------
     Paleta de HalloweenWhatsNewPalette en la app: night #03061d, pumpkin
     #ff7700, amber #ffa300, candle #ffb347, violet #4f2f88, muted #a3a8c9,
     web #d9ccff. La tarjeta se queda cuadrada aunque en la app tenga radio 24:
     aquí todo es pixel art y el redondeo desentona. */

  /* Los personajes asoman 84 px por encima de la tarjeta; sin este margen
     se meterían en la versión de arriba. */
  .release--halloween {
    margin-top: 60px;
  }

  .release-node--halloween {
    box-shadow: inset 0 0 0 3px #ff7700;
    color: #ff7700;
  }

  .hw-peekers {
    position: absolute;
    top: 0;
    right: 58px;
  }

  /* Detrás de la tarjeta (z-index 0 frente a su 1): solo se les ve lo que
     sobresale del borde superior, como en la app. */
  /* max-width: none porque el preflight de Tailwind pone max-width: 100% a
     las imágenes, y su contenedor mide 0 de ancho: sin esto no se ven. */
  .hw-peeker {
    position: absolute;
    top: -84px;
    width: 118px;
    height: 118px;
    max-width: none;
    object-fit: contain;
  }

  .hw-peeker--vampire_male {
    right: 180px;
    transform: rotate(-6deg);
  }

  .hw-peeker--mummy_female {
    right: 92px;
    transform: rotate(5deg);
  }

  .hw-peeker--pirate_female {
    right: 6px;
    transform: rotate(14deg);
  }

  .release-card--halloween {
    position: relative;
    z-index: 1;
    overflow: hidden;
    background: #03061d;
    border-color: rgba(255, 163, 0, 0.5);
    box-shadow:
      0 0 14px rgba(255, 163, 0, 0.45),
      0 20px 40px rgba(0, 0, 0, 0.5);
  }

  .hw-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hw-glow {
    position: absolute;
    top: -70px;
    right: -60px;
    width: 260px;
    height: 240px;
    background: radial-gradient(closest-side, rgba(79, 47, 136, 0.85), rgba(79, 47, 136, 0));
  }

  /* El rayo de luna en diagonal. */
  .hw-beam {
    position: absolute;
    top: -60px;
    left: 200px;
    width: 26px;
    height: 380px;
    background: rgba(187, 218, 237, 0.16);
    transform: rotate(18deg);
  }

  .hw-cobweb {
    position: absolute;
    top: 0;
    right: 0;
    opacity: 0.55;
    fill: none;
    stroke: #d9ccff;
    stroke-width: 1.1;
    stroke-linecap: round;
  }

  .hw-spider {
    position: absolute;
    top: 0;
    right: 38px;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: top center;
    animation: hw-swing 0.8s ease-in-out infinite alternate;
  }

  .hw-spider__thread {
    width: 1px;
    height: 64px;
    background: rgba(217, 204, 255, 0.6);
  }

  /* ±3° en un ciclo de 1,6 s de ida y vuelta (0,8 s cada sentido). */
  @keyframes hw-swing {
    from {
      transform: rotate(-3deg);
    }
    to {
      transform: rotate(3deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hw-spider {
      animation: none;
    }
  }

  /* La franja de arbustos y calabazas: 128 × 18 a 3×, repetida a lo ancho.
     En la app se estira al ancho del móvil; aquí la tarjeta llega a 700 px y
     estirada mediría casi 100 px de alto. */
  .hw-ground {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 54px;
    background: url('/images/changelog/halloween-2026/foreground.png') repeat-x left bottom / auto 54px;
    image-rendering: pixelated;
  }

  .release-card--halloween .release-head,
  .release-card--halloween .entry-list {
    position: relative;
  }

  /* Hueco a la derecha para que la fecha no caiga encima de la telaraña
     (132 px) ni de la araña. */
  .release-card--halloween .release-head {
    padding-right: 140px;
    background: transparent;
    border-bottom: 3px solid rgba(255, 163, 0, 0.35);
  }

  .release-card--halloween .entry-list {
    padding-bottom: 58px;
  }

  .release-card--halloween .release-version {
    background: rgba(79, 47, 136, 0.45);
    border-color: rgba(255, 163, 0, 0.5);
    color: #ffb347;
  }

  .release-card--halloween .release-version__label,
  .release-card--halloween .release-date {
    color: #a3a8c9;
  }

  .release-card--halloween .release-codename {
    font-family: 'Creepster', 'Poppins', sans-serif;
    font-size: 30px;
    letter-spacing: 0.02em;
    line-height: 1;
    color: #ff7700;
  }

  .release-card--halloween .entry + .entry {
    border-top-color: rgba(163, 168, 201, 0.15);
  }

  .release-card--halloween .entry-icon {
    background: rgba(79, 47, 136, 0.45);
    border-color: rgba(255, 163, 0, 0.35);
  }

  .release-card--halloween .entry-title {
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    color: #ffffff;
  }

  .release-card--halloween .entry-text {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: #a3a8c9;
  }

  /* La primera entrada va destacada, como en el modal. */
  .release-card--halloween .entry:first-child {
    margin: 16px 16px 4px;
    padding-right: 56px;
    background: rgba(117, 172, 205, 0.07);
    border: 3px solid rgba(255, 163, 0, 0.35);
  }

  .release-card--halloween .entry:first-child + .entry {
    border-top: 0;
  }

  .release-card--halloween .entry:first-child .entry-title {
    font-family: 'Creepster', 'Poppins', sans-serif;
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: #ffb347;
  }

  .release-card--halloween .entry:first-child .entry-text {
    color: #ffffff;
  }

  .release-card--halloween .tag {
    border-color: transparent;
  }

  .release-card--halloween .tag--feature {
    background: rgba(255, 119, 0, 0.2);
    color: #ffab5c;
  }

  .release-card--halloween .tag--improvement {
    background: rgba(160, 120, 255, 0.22);
    color: #c9b3ff;
  }

  .release-card--halloween .tag--fix {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  @media (max-width: 640px) {
    /* En móvil los tres a 118 px taparían toda la tarjeta. */
    .release--halloween {
      margin-top: 44px;
    }

    .hw-peekers {
      right: 0;
    }

    .hw-peeker {
      top: -60px;
      width: 84px;
      height: 84px;
    }

    .hw-peeker--vampire_male {
      right: 128px;
    }

    .hw-peeker--mummy_female {
      right: 66px;
    }

    .hw-peeker--pirate_female {
      right: 4px;
    }

    .release-card--halloween .entry:first-child {
      margin: 12px 12px 4px;
      padding-right: 16px;
    }

    .release-card--halloween .release-codename {
      font-size: 24px;
    }
  }

  @media (max-width: 640px) {
    .release {
      padding-left: 46px;
      /* En móvil el ancho escasea: se recupera el hueco de la derecha y se
         acepta el pequeño descentrado, que a esta anchura no se nota. */
      padding-right: 0;
    }

    .timeline-line {
      left: 13px;
    }

    .release-node {
      width: 30px;
      height: 30px;
      font-size: 10px;
    }

    .entry {
      padding: 16px;
    }

    .entry-icon {
      width: 38px;
      height: 38px;
      font-size: 18px;
    }

    .release-date {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
