const endpoints: [string, string, string, string][] = [
  ['GET', '/me', 'Your level, XP, coins, energy and the limits', 'Tu nivel, XP, monedas, energía y los límites'],
  ['GET', '/skills', 'List skills', 'Lista las skills'],
  ['POST', '/skills', 'Create a skill', 'Crea una skill'],
  ['GET', '/skills/{id}', 'One skill', 'Una skill'],
  ['PATCH', '/skills/{id}', 'Change a skill', 'Cambia una skill'],
  ['DELETE', '/skills/{id}', 'Archive a skill', 'Archiva una skill'],
  ['GET', '/tasks', 'List tasks, each with its skills', 'Lista las tareas, cada una con sus skills'],
  ['POST', '/tasks', 'Create a task', 'Crea una tarea'],
  ['GET', '/tasks/{id}', 'One task', 'Una tarea'],
  ['PATCH', '/tasks/{id}', 'Change a task', 'Cambia una tarea'],
  ['DELETE', '/tasks/{id}', 'Delete or archive a task', 'Borra o archiva una tarea'],
  ['POST', '/tasks/{id}/complete', 'Ask the app to complete it (202)', 'Pide a la app que la complete (202)'],
  ['GET', '/completions', 'Your completion requests and what happened', 'Tus peticiones de completar y qué pasó'],
  ['GET', '/categories', 'Your categories (read-only)', 'Tus categorías (solo lectura)'],
  ['GET', '/history', 'Your history: completions, level-ups… (read-only)', 'Tu historial: completados, subidas de nivel… (solo lectura)'],
]

const taskFields: [string, string, string][] = [
  ['title', 'text, 1–128', 'texto, 1–128'],
  ['description', 'text up to 2,000 or null', 'texto hasta 2.000 o null'],
  ['category_id', 'one of your categories; default: your first default one', 'una de tus categorías; por defecto, la primera predeterminada'],
  ['skills', '[{"skill_id": "…", "xp": -100…100}], up to 20; xp defaults to 10, negative takes XP away', '[{"skill_id": "…", "xp": -100…100}], hasta 20; xp vale 10 por defecto, negativo resta XP'],
  ['difficulty', 'very_easy, easy, medium (default), hard, very_hard', 'very_easy, easy, medium (por defecto), hard, very_hard'],
  ['priority', '1–5, default 3', '1–5, 3 por defecto'],
  ['energy_cost', '-50…50, default -1 (negative spends energy, positive gives it)', '-50…50, -1 por defecto (negativo gasta energía, positivo la da)'],
  ['coins', '0–100, default 10', '0–100, 10 por defecto'],
  ['health_effect', '-50…50', '-50…50'],
  ['estimated_duration', 'seconds, 0–86,400', 'segundos, 0–86.400'],
  ['is_recurring', 'true / false', 'true / false'],
  ['recurrence_pattern', 'daily, weekly, monthly, yearly, custom (needed if recurring)', 'daily, weekly, monthly, yearly, custom (obligatorio si es recurrente)'],
  ['custom_days', '"1,3,5": 1 = Monday … 7 = Sunday (for custom)', '"1,3,5": 1 = lunes … 7 = domingo (para custom)'],
  ['recurrence_target', '1–99 times per period', '1–99 veces por periodo'],
  ['recurrence_day_of_month', '1–31 (monthly, yearly)', '1–31 (monthly, yearly)'],
  ['recurrence_month', '1–12 (yearly)', '1–12 (yearly)'],
  ['recurrence_end_date', 'ISO date', 'fecha ISO'],
  ['deadline', 'ISO date, only for one-off tasks', 'fecha ISO, solo para tareas no recurrentes'],
  ['daily_deadline_time', '"HH:mm"', '"HH:mm"'],
  ['reminder_mode', 'auto (default), at_deadline, before_15, before_60, morning, custom, none', 'auto (por defecto), at_deadline, before_15, before_60, morning, custom, none'],
  ['reminder_minute', '0–1439, minute of the day (with custom)', '0–1439, minuto del día (con custom)'],
  ['is_penalty', 'true: lose rewards when the deadline passes', 'true: pierdes recompensa si pasa el plazo'],
  ['icon', 'an emoji, or assets/images/icons/<name>.png', 'un emoji, o assets/images/icons/<nombre>.png'],
  ['color', '#RRGGBB', '#RRGGBB'],
]

const skillFields: [string, string, string][] = [
  ['name', 'text, 1–32 (required)', 'texto, 1–32 (obligatorio)'],
  ['description', 'text up to 500 or null', 'texto hasta 500 o null'],
  ['icon', 'an emoji, or assets/images/icons/<name>.png', 'un emoji, o assets/images/icons/<nombre>.png'],
  ['color', '#RRGGBB or null', '#RRGGBB o null'],
  ['is_active', 'true / false', 'true / false'],
]

const authExample = `curl ${BASE}/me \\
  -H "Authorization: Bearer sk_live_…"`

const createExample = `curl -X POST ${BASE}/tasks \\
  -H "Authorization: Bearer $SKILLION_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "title": "Gym",
    "is_recurring": true,
    "recurrence_pattern": "custom",
    "custom_days": "1,3,5",
    "difficulty": "hard",
    "skills": [{ "skill_id": "<skill id>", "xp": 20 }]
  }'`

const completeExample = `curl -X POST ${BASE}/tasks/<task id>/complete \\
  -H "Authorization: Bearer $SKILLION_KEY"

# 202 → { "data": { "id": "…", "status": "pending", … } }`

const listExample = `const since = new Date(Date.now() - 86_400_000).toISOString()
let cursor = null
do {
  const url = new URL('${BASE}/tasks')
  url.searchParams.set('updated_since', since)
  if (cursor) url.searchParams.set('cursor', cursor)
  const res = await fetch(url, { headers: { Authorization: \`Bearer \${process.env.SKILLION_KEY}\` } })
  const page = await res.json()
  for (const task of page.data) console.log(task.title, task.status)
  cursor = page.next_cursor
} while (cursor)`

const errorExample = `{
  "error": {
    "code": "invalid_field",
    "message": "Some fields are not valid.",
    "details": { "custom_days": "must be weekdays like \\"1,3,5\\" …" }
  }
}`
---

<SiteNav lang={lang} altHref={altHref} section="legal" />

<main class="dev-page">
  <section class="dev-hero">
    <p class="hero-eyebrow">{T.eyebrow}</p>
    <h1 class="hero-title">{T.title}</h1>
    <p class="hero-subtitle">{T.intro}</p>
    <p class="hero-base"><code>{BASE}</code></p>
  </section>

  <div class="dev-body">
    <section class="dev-section" id="key">
      <h2 class="section-title">{T.keyTitle}</h2>
      <ol class="steps">{T.keySteps.map((s) => <li>{s}</li>)}</ol>
      <p class="note">{T.keyNote}</p>
    </section>

    <section class="dev-section" id="auth">
      <h2 class="section-title">{T.authTitle}</h2>
      <p>{T.authText}</p>
      <pre><code>{authExample}</code></pre>
    </section>

    <section class="dev-section" id="limits">
      <h2 class="section-title">{T.limitsTitle}</h2>
      <ul class="facts">{T.limits.map(([a, b]) => <li><strong>{a}</strong>{b && <span> · {b}</span>}</li>)}</ul>
      <p class="note">{T.limitsNote}</p>
    </section>

    <section class="dev-section" id="endpoints">
      <h2 class="section-title">{T.endpointsTitle}</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>{T.method}</th><th>{T.path}</th><th>{T.what}</th></tr></thead>
          <tbody>
            {endpoints.map(([m, p, en, es]) => (
              <tr><td><span class={`verb verb-${m.toLowerCase()}`}>{m}</span></td><td><code>/v1{p}</code></td><td>{isEs ? es : en}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="dev-section" id="paging">
      <h2 class="section-title">{T.pagingTitle}</h2>
      <p>{T.pagingText}</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>{T.param}</th><th>{T.rule}</th></tr></thead>
          <tbody>{T.paging.map(([p, r]) => <tr><td><code>{p}</code></td><td>{r}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="dev-section" id="tasks">
      <h2 class="section-title">{T.tasksTitle}</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>{T.field}</th><th>{T.rule}</th></tr></thead>
          <tbody>{taskFields.map(([f, en, es]) => <tr><td><code>{f}</code></td><td>{isEs ? es : en}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">{T.tasksNote}</p>
    </section>

    <section class="dev-section" id="skills">
      <h2 class="section-title">{T.skillsTitle}</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>{T.field}</th><th>{T.rule}</th></tr></thead>
          <tbody>{skillFields.map(([f, en, es]) => <tr><td><code>{f}</code></td><td>{isEs ? es : en}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">{T.skillsNote}</p>
    </section>

    <section class="dev-section" id="complete">
      <h2 class="section-title">{T.completeTitle}</h2>
      <p>{T.completeText}</p>
      <p class="note">{T.completeNote}</p>
    </section>

    <section class="dev-section" id="delete">
      <h2 class="section-title">{T.deleteTitle}</h2>
      <p>{T.deleteText}</p>
    </section>

    <section class="dev-section" id="sync">
      <h2 class="section-title">{T.syncTitle}</h2>
      <ul class="facts">{T.sync.map((s) => <li>{s}</li>)}</ul>
    </section>

    <section class="dev-section" id="errors">
      <h2 class="section-title">{T.errorsTitle}</h2>
      <p>{T.errorsText}</p>
      <pre><code>{errorExample}</code></pre>
      <div class="table-wrap">
        <table>
          <thead><tr><th>HTTP</th><th>{T.code}</th><th>{T.what}</th></tr></thead>
          <tbody>{T.errors.map(([h, c, w]) => <tr><td>{h}</td><td><code>{c}</code></td><td>{w}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="dev-section" id="examples">
      <h2 class="section-title">{T.examplesTitle}</h2>
      <h3 class="example-title">{T.exCreate}</h3>
      <pre><code>{createExample}</code></pre>
      <h3 class="example-title">{T.exComplete}</h3>
      <pre><code>{completeExample}</code></pre>
      <h3 class="example-title">{T.exList}</h3>
      <pre><code>{listExample}</code></pre>
    </section>

    <p class="help">{T.help} <a href={isEs ? '/es/contact/' : '/contact/'}>{T.contact}</a></p>
  </div>
</main>

<style>
  .dev-page {
    background: #0f1526;
    color: #c9d6f5;
    font-family: 'Nunito', 'Poppins', sans-serif;
  }

  /* ---------- HERO ---------- */
  .dev-hero {
    padding: 72px 24px 48px;
    text-align: center;
    background: linear-gradient(#141b32 0%, #0f1526 100%);
    border-bottom: 4px solid #1b2547;
  }

  .hero-eyebrow {
    margin: 0 0 18px;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: 0.1em;
    color: #8fe3da;
  }

  .hero-title {
    margin: 0 0 20px;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: clamp(16px, 3.4vw, 30px);
    line-height: 1.5;
    color: #ffe6a0;
    text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.45);
    text-wrap: balance;
  }

  .hero-subtitle {
    margin: 0 auto 20px;
    max-width: 560px;
    font-size: clamp(15px, 2.2vw, 18px);
    font-weight: 700;
    line-height: 1.55;
    color: #8fa6dd;
    text-wrap: pretty;
  }

  .hero-base code {
    display: inline-block;
    max-width: 100%;
    padding: 8px 12px;
    overflow-wrap: anywhere;
    font-size: 13px;
    color: #ffe6a0;
    background: #141b32;
    border: 3px solid #3f5da8;
  }

  /* ---------- CUERPO ---------- */
  .dev-body {
    max-width: 860px;
    margin: 0 auto;
    padding: 56px 24px 72px;
  }

  .dev-section {
    margin-bottom: 56px;
  }

  .section-title {
    margin: 0 0 20px;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    /* Rótulos sin tildes a propósito: Press Start 2P no tiene mayúsculas
       acentuadas (ver FaqPage). */
    font-size: 11px;
    line-height: 1.7;
    color: #8fe3da;
    padding-bottom: 14px;
    border-bottom: 3px solid #1b2547;
  }

  .example-title {
    margin: 28px 0 12px;
    font-size: 16px;
    color: #ffe6a0;
  }

  p,
  li {
    font-size: 16px;
    line-height: 1.65;
  }

  .note {
    color: #8fa6dd;
    font-size: 15px;
  }

  .steps,
  .facts {
    padding-left: 22px;
  }

  .steps li,
  .facts li {
    margin-bottom: 8px;
  }

  .facts strong {
    color: #ffe6a0;
  }

  code {
    font-family: 'JetBrains Mono', 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.92em;
    color: #ffe6a0;
  }

  pre {
