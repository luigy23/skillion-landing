const authExample = `curl ${BASE}/me \\
  -H "Authorization: Bearer sk_live_…"`

const createExample = `curl -X POST ${BASE}/tasks \\
  -H "Authorization: Bearer $SKILLION_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "title": "Gym",
    "is_recurring": true,
    "recurrence_pattern": "custom",
    "custom_days": "1,3,5",
    "difficulty": "hard",
    "skills": [{ "skill_id": "<skill id>", "xp": 20 }]
  }'`

const completeExample = `curl -X POST ${BASE}/tasks/<task id>/complete \\
  -H "Authorization: Bearer $SKILLION_KEY"

# 202 → { "data": { "id": "…", "status": "pending", … } }`

const listExample = `const since = new Date(Date.now() - 86_400_000).toISOString()
let cursor = null
do {
  const url = new URL('${BASE}/tasks')
  url.searchParams.set('updated_since', since)
  if (cursor) url.searchParams.set('cursor', cursor)
  const res = await fetch(url, { headers: { Authorization: \`Bearer \${process.env.SKILLION_KEY}\` } })
  const page = await res.json()
  for (const task of page.data) console.log(task.title, task.status)
  cursor = page.next_cursor
} while (cursor)`

const weekExample = `const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
for (const name of days) {
  const weekend = name === 'Saturday' || name === 'Sunday'
  const res = await fetch('${BASE}/routines', {
    method: 'POST',
    headers: { Authorization: \`Bearer \${process.env.SKILLION_KEY}\`, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      name,
      blocks: [
        { start_minute: weekend ? 540 : 420, duration_minute: 30, title: 'Read' },
        { start_minute: 1080, duration_minute: 60, title: 'Gym', color: '#F29092' },
        { start_minute: 1380, duration_minute: 60, title: 'Wind down' },
      ],
    }),
  })
  if (!res.ok) console.error(name, (await res.json()).error)
}`

const quickstartExample = `export SKILLION_KEY="sk_live_…"   ${T.keyComment}

curl ${BASE}/me \\
  -H "Authorization: Bearer $SKILLION_KEY"`

// Forma real de GET /me (skillion-infra functions/api.ts, ruta 'me'); los
// valores son de ejemplo.
const meExample = `{
  "data": {
    "level": 7,
    "total_xp": 140,
    "xp_to_next_level": 350,
    "coins": 820,
    "energy_points": 64,
    "max_energy": 100,
    "health_points": 100,
    "max_health": 100,
    "nickname": "Luna",
    "updated_at": "2026-10-21T18:00:00Z"
  },
  "limits": { "per_minute": 120, "per_day": 10000, "page_max": 100 }
}`

// Los campos de tarea que casi todo el mundo usa van a la vista; el resto,
// plegados. Solo title es obligatorio.
const COMMON_TASK_FIELDS = new Set([
  'title', 'description', 'category_id', 'skills', 'difficulty',
  'is_recurring', 'recurrence_pattern', 'custom_days', 'deadline',
])
const commonTaskFields = taskFields.filter(([f]) => COMMON_TASK_FIELDS.has(f))
const moreTaskFields = taskFields.filter(([f]) => !COMMON_TASK_FIELDS.has(f))

const errorExample = `{
  "error": {
    "code": "invalid_field",
    "message": "Some fields are not valid.",
    "details": { "custom_days": "must be weekdays like \\"1,3,5\\" …" }
  }
}`

// Las comillas invertidas de los textos marcan código: rich() los parte y la
// plantilla pinta los trozos impares como <code>.
const rich = (text: string) => text.split('`');

// Las capturas de los pasos llegan aparte (public/images/developers/). Hasta
// que existan, el paso sale sin hueco: mejor eso que un recuadro vacío.
const shots = T.keySteps.map((_, i) => {
  const file = `/images/developers/paso-${i + 1}-${lang}.png`;
  return existsSync(join(process.cwd(), 'public', file)) ? file : null;
});
const hasShots = shots.some(Boolean);

// Endpoints agrupados por recurso, en el orden de la tabla.
const endpointGroups = endpoints.reduce<{ label: string; rows: typeof endpoints }[]>((acc, row) => {
  const label = T.groups[row[1].split('/')[1] as keyof typeof T.groups];
  const last = acc[acc.length - 1];
  if (last && last.label === label) last.rows.push(row);
  else acc.push({ label, rows: [row] });
  return acc;
}, []);
