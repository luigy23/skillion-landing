<script>
  function initDevDocs() {
    const root = document.querySelector<HTMLElement>('.dev-page');
    // Con el ClientRouter esto corre en la carga y en cada astro:page-load:
    // sin la marca, volver a la página duplicaría los listeners.
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    root.querySelectorAll<HTMLButtonElement>('.copy').forEach((button) => {
      const label = button.textContent ?? '';
      button.addEventListener('click', async () => {
        const text =
          button.dataset.copyText ?? button.closest('.code')?.querySelector('pre')?.innerText ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          return;
        }
        button.textContent = button.dataset.copied ?? label;
        button.classList.add('is-copied');
        window.setTimeout(() => {
          button.textContent = label;
          button.classList.remove('is-copied');
        }, 1600);
      });
    });

    // En móvil el índice empieza plegado y se pliega al elegir sección; en
    // escritorio es la columna fija y siempre está abierto.
    const toc = root.querySelector<HTMLDetailsElement>('details.toc');
    const narrow = window.matchMedia('(max-width: 1023px)');
    if (toc && narrow.matches) toc.open = false;
    toc?.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        if (narrow.matches) toc.open = false;
      }),
    );

    // Marca en el índice la sección que se está leyendo.
    const links = new Map(
      Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')).map((a) => [
        a.hash.slice(1),
        a,
      ]),
    );
    // Arriba del todo ninguna sección ha entrado aún en la franja: la primera
    // es la que se va a leer.
    links.values().next().value?.setAttribute('aria-current', 'location');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('aria-current'));
          links.get(entry.target.id)?.setAttribute('aria-current', 'location');
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    root.querySelectorAll('.dev-section').forEach((section) => observer.observe(section));
  }

  initDevDocs();
  document.addEventListener('astro:page-load', initDevDocs);
</script>

<style>
  /* Tipografía con un papel por fuente (NN/g, COGA, guía de la BDA):
     - Press Start 2P solo donde es marca y va grande: el título y los números
       de los pasos. A 8–11 px se leía mal y no tiene mayúsculas con tilde.
     - Nunito para todo lo que se lee o se pulsa: títulos, índice, botones.
     - JetBrains Mono para el código, las rutas y los métodos. */
  .dev-page {
    background: #0f1526;
    color: #c9d6f5;
    font-family: 'Nunito', 'Poppins', sans-serif;
  }

  .dev-page ::selection {
    background: #ffc53d;
    color: #0a0f1f;
  }

  .dev-page :focus-visible {
    outline: 3px solid #ffc53d;
    outline-offset: 2px;
  }

  /* El único amarillo subrayado de la página es un enlace: el código ya no
     comparte color con ellos. */
  .dev-page a:not(.btn-primary) {
    color: #ffc53d;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .dev-page a:not(.btn-primary):hover {
    color: #ffe08a;
  }

  /* ---------- CABECERA ---------- */
  .dev-hero {
    background: linear-gradient(#141b32 0%, #0f1526 100%);
    border-bottom: 4px solid #1b2547;
  }

  .dev-hero__inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 64px 24px 48px;
  }

  .hero-title {
    margin: 0 0 16px;
    font-family: 'Press Start 2P', 'Courier New', monospace;
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 400;
    line-height: 1.5;
    color: #ffe6a0;
    text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.45);
  }

  .hero-subtitle {
    margin: 0 0 8px;
    max-width: 58ch;
    font-size: clamp(16px, 2vw, 18px);
    font-weight: 700;
    line-height: 1.55;
    color: #c9d6f5;
    text-wrap: pretty;
  }

  /* Texto, no etiquetas: con marco parecían botones y no hacían nada. */
  .hero-meta {
    margin: 0 0 28px;
    font-size: 15px;
    font-weight: 700;
    color: #8fa6dd;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  /* El único botón principal de la página: lleva al primer paso. */
  .btn-primary {
    display: inline-block;
    padding: 13px 18px;
    font-size: 16px;
    font-weight: 900;
    line-height: 1.2;
    color: #2a1a06;
    text-decoration: none;
    background: #ffc53d;
    border: 4px solid #0a0f1f;
    box-shadow: 6px 6px 0 rgba(5, 8, 18, 0.45);
    transition: transform 120ms ease-out, box-shadow 120ms ease-out, background-color 120ms ease-out;
  }

  .btn-primary:hover {
    background: #ffd365;
    transform: translate(-1px, -1px);
    box-shadow: 7px 7px 0 rgba(5, 8, 18, 0.45);
  }

  .btn-primary:active {
    transform: translate(3px, 3px);
