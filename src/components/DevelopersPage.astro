const authExample = `curl ${BASE}/me \\
  -H "Authorization: Bearer sk_live_…"`

const createExample = `curl -X POST ${BASE}/tasks \\
  -H "Authorization: Bearer $SKILLION_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "title": "Gym",
    "is_recurring": true,
    "recurrence_pattern": "custom",
    "custom_days": "1,3,5",
    "difficulty": "hard",
    "skills": [{ "skill_id": "<skill id>", "xp": 20 }]
  }'`

const completeExample = `curl -X POST ${BASE}/tasks/<task id>/complete \\
  -H "Authorization: Bearer $SKILLION_KEY"

# 202 → { "data": { "id": "…", "status": "pending", … } }`

const listExample = `const since = new Date(Date.now() - 86_400_000).toISOString()
let cursor = null
do {
  const url = new URL('${BASE}/tasks')
  url.searchParams.set('updated_since', since)
  if (cursor) url.searchParams.set('cursor', cursor)
  const res = await fetch(url, { headers: { Authorization: \`Bearer \${process.env.SKILLION_KEY}\` } })
  const page = await res.json()
  for (const task of page.data) console.log(task.title, task.status)
  cursor = page.next_cursor
} while (cursor)`

const errorExample = `{
  "error": {
    "code": "invalid_field",
    "message": "Some fields are not valid.",
    "details": { "custom_days": "must be weekdays like \\"1,3,5\\" …" }
  }
}`

// Las comillas invertidas de los textos marcan código: rich() los parte y la
// plantilla pinta los trozos impares como <code>.
const rich = (text: string) => text.split('`');

// Las capturas de los pasos llegan aparte (public/images/developers/). Hasta
// que existan, el paso sale sin hueco: mejor eso que un recuadro vacío.
const shots = T.keySteps.map((_, i) => {
  const file = `/images/developers/paso-${i + 1}-${lang}.png`;
  return existsSync(join(process.cwd(), 'public', file)) ? file : null;
});
const hasShots = shots.some(Boolean);

// Endpoints agrupados por recurso, en el orden de la tabla.
const endpointGroups = endpoints.reduce<{ label: string; rows: typeof endpoints }[]>((acc, row) => {
  const label = T.groups[row[1].split('/')[1] as keyof typeof T.groups];
  const last = acc[acc.length - 1];
  if (last && last.label === label) last.rows.push(row);
  else acc.push({ label, rows: [row] });
  return acc;
}, []);
---

<SiteNav lang={lang} altHref={altHref} section="legal" />

<main class="dev-page">
  <header class="dev-hero">
    <div class="dev-hero__inner">
      <h1 class="hero-title">{T.title}</h1>
      <p class="hero-subtitle">{T.intro}</p>
      <div class="base">
        <span class="base__label">{T.baseLabel}</span>
        <code class="base__url">{BASE}</code>
        <button type="button" class="copy" data-copy-text={BASE} data-copied={T.copied}>{T.copy}</button>
      </div>
      <ul class="hero-meta">{T.meta.map((m) => <li>{m}</li>)}</ul>
    </div>
  </header>

  <div class="dev-layout">
    <details class="toc" open>
      <summary class="toc__summary">{T.onThisPage}</summary>
      <nav aria-label={T.onThisPage}>
        {T.toc.map(([group, items]) => (
          <div class="toc__group">
            <p class="toc__label">{group}</p>
            <ul>
              {items.map(([id, label]) => (
                <li><a href={`#${id}`} data-toc-link>{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </details>

    <div class="dev-content">
      <section class="dev-section" id="key">
        <h2 class="section-title">{T.keyTitle}<a class="anchor" href="#key" aria-hidden="true" tabindex="-1">#</a></h2>
        <ol class:list={['steps', hasShots && 'steps--shots']}>
          {T.keySteps.map((step, i) => (
            <li class="step">
              <span class="step__num" aria-hidden="true">{i + 1}</span>
              <div class="step__body">
                <p>{step}</p>
                {shots[i] && (
                  <img
                    class="step__shot"
                    src={shots[i]}
                    alt={T.shotAlt[i]}
                    width="1179"
                    height="2556"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
            </li>
          ))}
        </ol>
        <p class="note">{T.keyNote}</p>
      </section>

      <section class="dev-section" id="auth">
        <h2 class="section-title">{T.authTitle}<a class="anchor" href="#auth" aria-hidden="true" tabindex="-1">#</a></h2>
        <p>{rich(T.authText).map((seg, i) => (i % 2 ? <code>{seg}</code> : seg))}</p>
        <div class="code">
          <div class="code__bar"><span>curl</span><button type="button" class="copy" data-copied={T.copied}>{T.copy}</button></div>
          <pre><code>{authExample}</code></pre>
        </div>
      </section>

      <section class="dev-section" id="limits">
        <h2 class="section-title">{T.limitsTitle}<a class="anchor" href="#limits" aria-hidden="true" tabindex="-1">#</a></h2>
        <dl class="limits">
          {T.limits.map(([a, b]) => (
            <div class="limits__row">
              <dt>{a}</dt>
              {b && <dd>{b}</dd>}
            </div>
          ))}
        </dl>
        <p class="note">{rich(T.limitsNote).map((seg, i) => (i % 2 ? <code>{seg}</code> : seg))}</p>
      </section>

      <section class="dev-section" id="endpoints">
        <h2 class="section-title">{T.endpointsTitle}<a class="anchor" href="#endpoints" aria-hidden="true" tabindex="-1">#</a></h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">{T.method}</th><th scope="col">{T.path}</th><th scope="col">{T.what}</th></tr></thead>
            {endpointGroups.map((group) => (
              <tbody>
                <tr class="group-row"><th scope="colgroup" colspan="3">{group.label}</th></tr>
                {group.rows.map(([m, p, en, es]) => (
                  <tr>
                    <td><span class={`verb verb-${m.toLowerCase()}`}>{m}</span></td>
                    <td><code>/v1{p}</code></td>
                    <td>{isEs ? es : en}</td>
                  </tr>
                ))}
              </tbody>
            ))}
