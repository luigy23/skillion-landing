---
/**
 * Documentación de la API pública de Skillion (SCRUM-506). El MCP tiene su
 * propia página (McpPage.astro) con las mismas operaciones.
 *
 * La API es solo para Premium y la clave se saca de un rincón escondido de
 * Ajustes (tocar 7 veces la versión): esta página es la única que lo cuenta.
 * Los pasos y los rótulos salen de skillapp (settings_version_line.dart,
 * developer_api_settings_entry.dart): si allí cambian, se cambian aquí.
 *
 * Las fichas de cada endpoint salen de src/data/api-reference.json, generado
 * desde el servidor (lib/api-docs.ts explica cómo): las rutas, los campos, los
 * límites y las respuestas de ejemplo son los del servidor, no una copia.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import SiteNav from './SiteNav.astro';
import OpCard from './dev/OpCard.astro';
import Callout from './dev/Callout.astro';
import CodeBlock from './dev/CodeBlock.astro';
import Rich from './dev/Rich.astro';
import type { Lang } from '../lib/blog';
import {
  anchorOf, BASE, checkCoverage, ERRORS, GROUPS, groupOf, LIMITS, OPS, pick,
} from '../lib/api-docs';
import '../styles/dev-docs.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const isEs = lang === 'es';
checkCoverage(lang);

const altHref = isEs ? '/developers/' : '/es/desarrolladores/';
const mcpHref = isEs ? '/es/desarrolladores/mcp/' : '/developers/mcp/';
const mdHref = isEs ? '/es/desarrolladores.md' : '/developers.md';
const n = (v: number) => v.toLocaleString(isEs ? 'es' : 'en');

const T = {
  en: {
    title: 'Skillion API',
    intro:
      'Read and change your own skills, tasks, routines and calendar from your scripts, shortcuts and ' +
      'integrations. Part of Skillion Premium.',
    meta: 'Premium only · JSON · Bearer token',
    baseLabel: 'Base URL',
    qsCta: 'Start with your first call',
    mcpLink: 'Use it from an AI assistant (MCP)',
    mdLink: 'This page as Markdown',
    copyMd: 'Copy as Markdown',
    keyTitle: 'Get your key',
    keySteps: [
      'Open Skillion and go to Settings.',
      'Scroll to the bottom and tap the line «Version …» seven times in a row, with less than 2 seconds between taps. Your phone vibrates and you see «Developer options unlocked».',
      'A new row appears in Settings: «Developer API». Open it.',
      'Tap «Create key», give it a name and tap «Create». Then tap «Copy»: the key is shown only once. You can have up to 5 active keys and revoke any of them on that screen.',
    ],
    keyNeed:
      'You need Skillion Premium and a registered account (not a guest one). Without Premium the row shows a ' +
      'lock and opens the paywall.',
    keySecret:
      'Treat a key like a password: anyone with it can change your tasks. If one leaks, revoke it on that same screen.',
    authTitle: 'Authentication',
    authText: 'Send the key as a `Bearer` token on every request. All bodies are JSON.',
    limitsTitle: 'Limits',
    limits: [
      [`${n(LIMITS.per_minute)} requests per minute`, 'per account: all your keys and the MCP together'],
      [`${n(LIMITS.per_day)} requests per day`, 'per account, the day resets at 00:00 UTC'],
      [`${LIMITS.page_max} items per page`, 'default 50'],
      ['64 KB per body', ''],
    ],
    limitsNote:
      'Over a limit you get `429` with a `retry-after` header (seconds). Every answer carries ' +
      '`x-ratelimit-limit` and `x-ratelimit-remaining`.',
    pagingTitle: 'Lists and paging',
    pagingText:
      'Lists come oldest change first. Pass `next_cursor` back as `cursor` until it is `null`. ' +
      'Deleted and archived items are left out unless you ask for them.',
    paging: [
      ['limit', `1 to ${LIMITS.page_max}, default 50`],
      ['cursor', 'the next_cursor of the previous page'],
      ['updated_since', 'ISO date: only what changed after it'],
      ['include_deleted', 'true to also get deleted items (deleted_at set)'],
      ['include_archived', 'true to also get archived skills and tasks'],
    ],
    errorsTitle: 'Errors',
    errorsText:
      '`2xx` worked. `4xx` is something in the request: the body says what. `5xx` is on our side. Errors always ' +
      'have the same shape, and `details` lists each field that was not valid.',
    syncTitle: 'Good to know',
    sync: [
      'Changes reach your phone on its next sync, usually when you open the app.',
      'If you edit the same task on your phone before it syncs, the phone wins.',
      'Recurring tasks get their next due date from your phone, which knows your time zone and daily reset hour.',
      'Dates are ISO 8601 with a time zone, for example `2026-10-21T18:00:00Z`.',
      'Calendar dates (days, commitments) are your local date, for example `2026-11-10`.',
      '`DELETE` does what the app does: skills and recurring tasks are archived (their history stays), the rest is deleted.',
    ],
    indexTitle: 'All endpoints',
    examplesTitle: 'Recipes',
    exList: 'Read everything that changed since yesterday',
    exWeek: 'Plan your week: workdays and weekend',
    exDay: 'Take Friday off, or use another routine that day only',
    field: 'Field',
    rule: 'Rule',
    param: 'Parameter',
    code: 'Code',
    what: 'What happened',
    fix: 'What to do',
    onThisPage: 'On this page',
    copy: 'Copy',
    copied: 'Copied',
    toTop: '↑ Top',
    partStart: 'Get started',
    partRef: 'Reference',
    partMore: 'More',
    toc: {
      quickstart: 'Your first call', key: 'Your key', auth: 'Authentication', limits: 'Limits',
      paging: 'Lists and paging', errors: 'Errors', sync: 'Good to know', index: 'All endpoints',
      mcp: 'AI assistants (MCP)', examples: 'Recipes',
    },
    shotAlt: [
      'Skillion screenshot with an arrow on the way into Settings',
      'Screenshot of the bottom of Settings with an arrow on the version line',
      'Screenshot of Settings with the new Developer API row',
      'Screenshot of the new key with an arrow on Copy',
    ],
    qsTitle: 'Your first call',
    qsSteps: [
      'Get your key in the app: Settings → tap the version 7 times → Developer API.',
      'Ask for your profile:',
      'You get your level, XP, coins and energy, and your limits:',
    ],
    qsMore: 'Step by step, in detail',
    keyComment: '# yours, from the app',
    responseLabel: 'Response · example',
    warnLabel: 'Heads up',
    help: 'Help? Write to us from the contact page.',
    contact: 'Contact',
  },
  es: {
    title: 'API de Skillion',
    intro:
      'Lee y cambia tus propias skills, tareas, rutinas y calendario desde tus scripts, atajos e ' +
      'integraciones. Incluida en Skillion Premium.',
    meta: 'Solo Premium · JSON · Token Bearer',
    baseLabel: 'URL base',
    qsCta: 'Empieza por tu primera llamada',
    mcpLink: 'Úsala desde un asistente de IA (MCP)',
    mdLink: 'Esta página en Markdown',
    copyMd: 'Copiar como Markdown',
    keyTitle: 'Tu clave',
    keySteps: [
      'Abre Skillion y ve a Ajustes.',
      'Baja hasta el final y toca siete veces seguidas la línea «Versión …», con menos de 2 segundos entre toque y toque. El móvil vibra y sale «Opciones de desarrollador activadas».',
      'En Ajustes aparece una fila nueva: «API para desarrolladores». Ábrela.',
      'Toca «Crear clave», ponle un nombre y toca «Crear». Después toca «Copiar»: la clave solo se enseña una vez. Puedes tener hasta 5 activas y revocar cualquiera desde esa pantalla.',
    ],
    keyNeed:
      'Necesitas Skillion Premium y una cuenta registrada (no de invitado). Sin Premium la fila sale con candado ' +
      'y abre la pantalla de suscripción.',
    keySecret:
      'Trata la clave como una contraseña: quien la tenga puede cambiar tus tareas. Si se te escapa, revócala en ' +
      'esa misma pantalla.',
    authTitle: 'Autenticación',
    authText: 'Manda la clave como token `Bearer` en cada petición. Todos los cuerpos van en JSON.',
    limitsTitle: 'Límites',
    limits: [
      [`${n(LIMITS.per_minute)} peticiones por minuto`, 'por cuenta: todas tus claves y el MCP juntos'],
      [`${n(LIMITS.per_day)} peticiones al día`, 'por cuenta, el día empieza a las 00:00 UTC'],
      [`${LIMITS.page_max} elementos por página`, '50 por defecto'],
      ['64 KB por cuerpo', ''],
    ],
    limitsNote:
      'Si te pasas recibes `429` con la cabecera `retry-after` (segundos). Cada respuesta lleva ' +
      '`x-ratelimit-limit` y `x-ratelimit-remaining`.',
    pagingTitle: 'Listas y paginado',
    pagingText:
      'Las listas vienen del cambio más antiguo al más nuevo. Devuelve `next_cursor` como `cursor` hasta que sea ' +
      '`null`. Lo borrado y lo archivado no sale salvo que lo pidas.',
    paging: [
      ['limit', `de 1 a ${LIMITS.page_max}, 50 por defecto`],
      ['cursor', 'el next_cursor de la página anterior'],
      ['updated_since', 'fecha ISO: solo lo que cambió después'],
      ['include_deleted', 'true para traer también lo borrado (con deleted_at)'],
      ['include_archived', 'true para traer también skills y tareas archivadas'],
    ],
    errorsTitle: 'Errores',
    errorsText:
      '`2xx` salió bien. `4xx` es algo de la petición: el cuerpo dice qué. `5xx` es de nuestro lado. Los errores ' +
      'tienen siempre la misma forma, y `details` dice qué campo no es válido.',
    syncTitle: 'Conviene saber',
    sync: [
      'Los cambios llegan a tu móvil en el siguiente sync, normalmente al abrir la app.',
      'Si editas la misma tarea en el móvil antes de que sincronice, gana el móvil.',
      'Las tareas recurrentes reciben su próxima fecha desde tu móvil, que sabe tu zona horaria y tu hora de reinicio.',
      'Las fechas van en ISO 8601 con zona horaria, por ejemplo `2026-10-21T18:00:00Z`.',
      'Las fechas de calendario (días, compromisos) son tu fecha local, por ejemplo `2026-11-10`.',
      '`DELETE` hace lo mismo que la app: las skills y las tareas recurrentes se archivan (su historial se queda) y lo demás se borra.',
    ],
    indexTitle: 'Todos los endpoints',
    examplesTitle: 'Recetas',
    exList: 'Leer todo lo que cambió desde ayer',
    exWeek: 'Organizar la semana: días de trabajo y finde',
    exDay: 'Tomarte el viernes libre, o usar otra rutina solo ese día',
    field: 'Campo',
    rule: 'Regla',
    param: 'Parámetro',
    code: 'Código',
    what: 'Qué pasó',
    fix: 'Qué hacer',
    onThisPage: 'En esta página',
    copy: 'Copiar',
    copied: 'Copiado',
    toTop: '↑ Arriba',
    partStart: 'Empezar',
    partRef: 'Referencia',
    partMore: 'Más',
    toc: {
      quickstart: 'Tu primera llamada', key: 'Tu clave', auth: 'Autenticación', limits: 'Límites',
      paging: 'Listas y paginado', errors: 'Errores', sync: 'Conviene saber', index: 'Todos los endpoints',
      mcp: 'Asistentes de IA (MCP)', examples: 'Recetas',
    },
    shotAlt: [
      'Captura de Skillion con la flecha en la entrada a Ajustes',
      'Captura del final de Ajustes con la flecha en la línea de la versión',
      'Captura de Ajustes con la fila nueva API para desarrolladores',
      'Captura de la clave nueva con la flecha en Copiar',
    ],
    qsTitle: 'Tu primera llamada',
    qsSteps: [
      'Saca tu clave en la app: Ajustes → toca 7 veces la versión → API para desarrolladores.',
      'Pide tu perfil:',
      'Te devuelve tu nivel, XP, monedas y energía, y tus límites:',
    ],
    qsMore: 'Paso a paso, con todo detalle',
    keyComment: '# la tuya, de la app',
    responseLabel: 'Respuesta · ejemplo',
    warnLabel: 'Ojo',
    help: '¿Dudas? Escríbenos desde la página de contacto.',
    contact: 'Contacto',
  },
}[lang];

const authExample = `curl ${BASE}/me \\
  -H "Authorization: Bearer sk_live_…"`;

const quickstartExample = `export SKILLION_KEY="sk_live_…"   ${T.keyComment}

curl ${BASE}/me \\
  -H "Authorization: Bearer $SKILLION_KEY"`;

const me = OPS.find((o) => o.name === 'get_me')!;
const meExample = JSON.stringify(me.example.response, null, 2);

const errorExample = `{
  "error": {
    "code": "invalid_field",
    "message": "Some fields are not valid.",
    "details": { "custom_days": "must be weekdays like \\"1,3,5\\" …" }
  }
}`;

const listExample = `const since = new Date(Date.now() - 86_400_000).toISOString()
let cursor = null
do {
  const url = new URL('${BASE}/tasks')
  url.searchParams.set('updated_since', since)
  if (cursor) url.searchParams.set('cursor', cursor)
  const res = await fetch(url, { headers: { Authorization: \`Bearer \${process.env.SKILLION_KEY}\` } })
  const page = await res.json()
  for (const task of page.data) console.log(task.title, task.status)
  cursor = page.next_cursor
} while (cursor)`;

const weekExample = `const api = (path, body) => fetch('${BASE}' + path, {
  method: 'POST',
  headers: { Authorization: \`Bearer \${process.env.SKILLION_KEY}\`, 'Content-Type': 'application/json' },
  body: JSON.stringify(body),
}).then((res) => res.json())

await api('/routines', {
  name: 'Workday',
  weekdays: [1, 2, 3, 4, 5],
  blocks: [
    { start_minute: 420, duration_minute: 30, title: 'Read' },
    { start_minute: 1080, duration_minute: 60, title: 'Gym', color: '#F29092' },
  ],
})
await api('/routines', {
  name: 'Weekend',
  weekdays: [6, 7],
  blocks: [{ start_minute: 600, duration_minute: 90, title: 'Long walk' }],
})`;

const dayExample = `# Friday 13 November off
curl -X PUT ${BASE}/days/2026-11-13 \\
  -H "Authorization: Bearer $SKILLION_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{ "free": true }'

# The Weekend routine that day only (add "every_week": true for every Friday)
curl -X PUT ${BASE}/days/2026-11-13 \\
  -H "Authorization: Bearer $SKILLION_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{ "routine_id": "<weekend routine id>" }'`;

// Las capturas de los pasos llegan aparte (public/images/developers/). Hasta
// que existan, el paso sale sin hueco: mejor eso que un recuadro vacío.
const shots = T.keySteps.map((_, i) => {
  const file = `/images/developers/paso-${i + 1}-${lang}.png`;
  return existsSync(join(process.cwd(), 'public', file)) ? file : null;
});
const hasShots = shots.some(Boolean);

const groups = GROUPS.map((g) => ({ ...g, ops: OPS.filter((o) => groupOf(o) === g) }));

const toc: [string, [string, string, boolean?][]][] = [
  [T.partStart, [['quickstart', T.toc.quickstart], ['key', T.toc.key], ['auth', T.toc.auth], ['limits', T.toc.limits],
    ['paging', T.toc.paging], ['errors', T.toc.errors], ['sync', T.toc.sync]]],
  [T.partRef, [['index', T.toc.index], ...groups.map((g) => [g.id, pick(lang, g.label)] as [string, string])]],
  [T.partMore, [[mcpHref, T.toc.mcp, true], ['examples', T.toc.examples]]],
];
---

<SiteNav lang={lang} altHref={altHref} section="legal" />

<main class="dev-page" data-lang="curl">
  <header class="dev-hero">
    <div class="dev-hero__inner">
      <h1 class="hero-title">{T.title}</h1>
      <p class="hero-subtitle">{T.intro}</p>
      <p class="hero-meta">{T.meta}</p>
      <div class="hero-actions">
        <a class="btn-primary" href="#quickstart">{T.qsCta}</a>
        <div class="base">
          <span class="base__label">{T.baseLabel}</span>
          <code class="base__url">{BASE}</code>
          <button type="button" class="copy" data-copy-text={BASE} data-copied={T.copied}>{T.copy}</button>
        </div>
      </div>
      <p class="hero-links">
        <a href={mcpHref}>{T.mcpLink} →</a>
        <a href={mdHref}>{T.mdLink}</a>
        <button type="button" class="copy" data-copy-url={mdHref} data-copied={T.copied}>{T.copyMd}</button>
      </p>
    </div>
  </header>

  <div class="dev-layout">
    <details class="toc" open>
      <summary class="toc__summary">{T.onThisPage}</summary>
      <nav aria-label={T.onThisPage}>
        {toc.map(([group, items]) => (
          <div class="toc__group">
            <p class="toc__label">{group}</p>
            <ul>
              {items.map(([id, label, out]) => (
                <li>{out
                  ? <a href={id} class="toc__out">{label}</a>
                  : <a href={`#${id}`} data-toc-link>{label}</a>}</li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </details>

    <div class="dev-content">
      {/* ---------- EMPEZAR ---------- */}
      <div class="prose">
        <section class="dev-section" id="quickstart">
          <h2 class="section-title">{T.qsTitle}<a class="anchor" href="#quickstart" aria-hidden="true" tabindex="-1">#</a></h2>
          <ol class="steps">
            <li class="step">
              <span class="step__num" aria-hidden="true">1</span>
              <div class="step__body">
                <p>{T.qsSteps[0]} <a href="#key">{T.qsMore}</a></p>
                <Callout warn label={T.warnLabel} text={T.keyNeed} />
              </div>
            </li>
            <li class="step">
              <span class="step__num" aria-hidden="true">2</span>
              <div class="step__body">
                <p>{T.qsSteps[1]}</p>
                <CodeBlock label="curl" code={quickstartExample} copy={T.copy} copied={T.copied} />
              </div>
            </li>
            <li class="step">
              <span class="step__num" aria-hidden="true">3</span>
              <div class="step__body">
                <p>{T.qsSteps[2]}</p>
                <div class="code">
                  <div class="code__bar"><span>{T.responseLabel}</span></div>
                  <pre><code>{meExample}</code></pre>
                </div>
              </div>
            </li>
          </ol>
        </section>

        <section class="dev-section" id="key">
          <h2 class="section-title">{T.keyTitle}<a class="anchor" href="#key" aria-hidden="true" tabindex="-1">#</a></h2>
          <ol class:list={['steps', hasShots && 'steps--shots']}>
            {T.keySteps.map((step, i) => (
              <li class="step">
                <span class="step__num" aria-hidden="true">{i + 1}</span>
                <div class="step__body">
                  <p>{step}</p>
                  {shots[i] && (
                    <img class="step__shot" src={shots[i]} alt={T.shotAlt[i]} width="1179" height="2556" loading="lazy" decoding="async" />
                  )}
                </div>
              </li>
            ))}
          </ol>
          <Callout warn label={T.warnLabel} text={T.keySecret} />
        </section>

        <section class="dev-section" id="auth">
          <h2 class="section-title">{T.authTitle}<a class="anchor" href="#auth" aria-hidden="true" tabindex="-1">#</a></h2>
          <p><Rich text={T.authText} /></p>
          <CodeBlock label="curl" code={authExample} copy={T.copy} copied={T.copied} />
        </section>

        <section class="dev-section" id="limits">
          <h2 class="section-title">{T.limitsTitle}<a class="anchor" href="#limits" aria-hidden="true" tabindex="-1">#</a></h2>
          <dl class="limits">
            {T.limits.map(([a, b]) => (
              <div class="limits__row">
                <dt>{a}</dt>
                {b && <dd>{b}</dd>}
              </div>
            ))}
          </dl>
          <Callout text={T.limitsNote} />
        </section>

        <section class="dev-section" id="paging">
          <h2 class="section-title">{T.pagingTitle}<a class="anchor" href="#paging" aria-hidden="true" tabindex="-1">#</a></h2>
          <p><Rich text={T.pagingText} /></p>
          <div class="table-wrap">
            <table>
              <thead><tr><th scope="col">{T.param}</th><th scope="col">{T.rule}</th></tr></thead>
              <tbody>{T.paging.map(([p, r]) => <tr><td><code>{p}</code></td><td>{r}</td></tr>)}</tbody>
            </table>
          </div>
        </section>

        <section class="dev-section" id="errors">
          <h2 class="section-title">{T.errorsTitle}<a class="anchor" href="#errors" aria-hidden="true" tabindex="-1">#</a></h2>
          <p><Rich text={T.errorsText} /></p>
          <CodeBlock label="JSON" code={errorExample} copy={T.copy} copied={T.copied} />
          <div class="table-wrap">
            <table class="errors-table">
              <thead><tr><th scope="col">HTTP</th><th scope="col">{T.code}</th><th scope="col">{T.what}</th><th scope="col">{T.fix}</th></tr></thead>
              <tbody>
                {ERRORS.map((e) => (
                  <tr>
                    <td class="num">{e.http}</td>
                    <td><code>{e.code}</code></td>
                    <td><Rich text={pick(lang, e.what)} /></td>
                    <td><Rich text={pick(lang, e.fix)} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="dev-section" id="sync">
          <h2 class="section-title">{T.syncTitle}<a class="anchor" href="#sync" aria-hidden="true" tabindex="-1">#</a></h2>
          <ul class="facts">
            {T.sync.map((s) => <li><Rich text={s} /></li>)}
          </ul>
        </section>
      </div>

      {/* ---------- REFERENCIA ---------- */}
      <p class="part-title">{T.partRef}</p>
      <section class="dev-section prose" id="index">
        <h2 class="section-title">{T.indexTitle}<a class="anchor" href="#index" aria-hidden="true" tabindex="-1">#</a></h2>
        <div class="table-wrap">
          <table class="idx">
            {groups.map((g) => (
              <tbody>
                <tr class="group-row"><th scope="colgroup" colspan="3"><a href={`#${g.id}`}>{pick(lang, g.label)}</a></th></tr>
                {g.ops.map((op) => (
                  <tr>
                    <td><a href={`#${anchorOf(op)}`}><span class={`verb verb-${op.method.toLowerCase()}`}>{op.method}</span></a></td>
                    <td><a href={`#${anchorOf(op)}`}><code>/v1{op.path}</code></a></td>
                    <td><a href={`#${anchorOf(op)}`} class="tool">{op.name}</a></td>
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      </section>

      {groups.map((g) => (
        <section class="dev-section" id={g.id}>
          <h2 class="section-title prose">{pick(lang, g.label)}<a class="anchor" href={`#${g.id}`} aria-hidden="true" tabindex="-1">#</a></h2>
          <p><Rich text={pick(lang, g.intro)} /></p>
          {g.ops.map((op) => <OpCard op={op} lang={lang} mcpHref={mcpHref} />)}
        </section>
      ))}

      {/* ---------- RECETAS ---------- */}
      <section class="dev-section prose" id="examples">
        <h2 class="section-title">{T.examplesTitle}<a class="anchor" href="#examples" aria-hidden="true" tabindex="-1">#</a></h2>
        <h3 class="example-title">{T.exList}</h3>
        <CodeBlock label="JavaScript" code={listExample} copy={T.copy} copied={T.copied} />
        <h3 class="example-title">{T.exWeek}</h3>
        <CodeBlock label="JavaScript" code={weekExample} copy={T.copy} copied={T.copied} />
        <h3 class="example-title">{T.exDay}</h3>
        <CodeBlock label="curl" code={dayExample} copy={T.copy} copied={T.copied} />
      </section>

      <p class="help">{T.help} <a href={isEs ? '/es/contact/' : '/contact/'}>{T.contact}</a></p>
    </div>
  </div>
  <button type="button" class="to-top">{T.toTop}</button>
</main>

