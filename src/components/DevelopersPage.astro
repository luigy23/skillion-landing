<script>
  function initDevDocs() {
    const root = document.querySelector<HTMLElement>('.dev-page');
    // Con el ClientRouter esto corre en la carga y en cada astro:page-load:
    // sin la marca, volver a la página duplicaría los listeners.
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    root.querySelectorAll<HTMLButtonElement>('.copy').forEach((button) => {
      const label = button.textContent ?? '';
      button.addEventListener('click', async () => {
        const text =
          button.dataset.copyText ?? button.closest('.code')?.querySelector('pre')?.innerText ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          return;
        }
        button.textContent = button.dataset.copied ?? label;
        button.classList.add('is-copied');
        window.setTimeout(() => {
          button.textContent = label;
          button.classList.remove('is-copied');
        }, 1600);
      });
    });

    // En móvil el índice empieza plegado y se pliega al elegir sección; en
    // escritorio es la columna fija y siempre está abierto.
    const toc = root.querySelector<HTMLDetailsElement>('details.toc');
    const narrow = window.matchMedia('(max-width: 1023px)');
    if (toc && narrow.matches) toc.open = false;
    toc?.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        if (narrow.matches) toc.open = false;
      }),
    );

    // Marca en el índice la sección que se está leyendo.
    const links = new Map(
      Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')).map((a) => [
        a.hash.slice(1),
        a,
      ]),
    );
    // Arriba del todo ninguna sección ha entrado aún en la franja: la primera
    // es la que se va a leer.
    links.values().next().value?.setAttribute('aria-current', 'location');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('aria-current'));
          links.get(entry.target.id)?.setAttribute('aria-current', 'location');
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    root.querySelectorAll('.dev-section').forEach((section) => observer.observe(section));
  }

  initDevDocs();
  document.addEventListener('astro:page-load', initDevDocs);
</script>

