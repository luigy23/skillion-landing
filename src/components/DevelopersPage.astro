---
/**
 * Documentación de la API pública de Skillion (SCRUM-506).
 *
 * La API es solo para Premium y la clave se saca de un rincón escondido de
 * Ajustes (tocar 7 veces la versión): esta página es la única que lo cuenta.
 * Por eso no está en el menú, pero sí en llms.txt y con su pareja EN/ES.
 *
 * Todo lo de aquí describe lo que hace de verdad el servidor
 * (skillion-infra/functions-server/functions/api.ts y api-resources.ts): si
 * cambia un límite o un campo allí, se cambia aquí en la misma tanda.
 */
import SiteNav from './SiteNav.astro';
import type { Lang } from '../lib/blog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const isEs = lang === 'es';
const altHref = isEs ? '/developers/' : '/es/desarrolladores/';
const BASE = 'https://api.skillion.app/functions/v1/api/v1';

