---
/**
 * Cambia una portada rota por el icono pixel del post.
 *
 * Sin esto, un `cover_image` que apunte a una URL caída deja el icono de
 * imagen rota del navegador en medio de la card. Con esto se ve exactamente lo
 * mismo que cuando el post no tiene portada: el icono sobre el fondo rayado.
 *
 * Los iconos no necesitan red (son assets del bundle), así que el respaldo no
 * puede fallar a su vez.
 *
 * Este componente sólo aporta el script. Astro lo agrupa una vez por página,
 * así que da igual cuántas portadas haya: se incluye una sola copia.
 */
---

<script>
  (function () {
    function swap(img: HTMLImageElement) {
      const fallback = img.parentElement?.querySelector<HTMLElement>('[data-cover-fallback]');
      if (!fallback) return;
      img.hidden = true;
      fallback.hidden = false;
    }

    function init() {
      for (const img of document.querySelectorAll<HTMLImageElement>('[data-cover]')) {
        // Marca de idempotencia: sin ella una portada ya procesada
        // volvería a engancharse si init se llamara dos veces.
        if (img.dataset.coverBound) continue;
        img.dataset.coverBound = '1';

        // Una imagen puede haber fallado ANTES de que corra este script: las
        // imágenes empiezan a cargar durante el parseo del HTML. En ese caso el
        // evento 'error' ya pasó y añadir el listener no serviría de nada, así
        // que se comprueba el estado a mano.
        if (img.complete && img.naturalWidth === 0) {
          swap(img);
        } else {
          img.addEventListener('error', () => swap(img), { once: true });
        }
      }
    }

    init();
  })();
</script>
