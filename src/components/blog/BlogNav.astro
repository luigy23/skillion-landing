---
import logoUrl from '../../assets/pixelartAssets/hero/skillionlogotransparent.png';

interface Props {
  lang: 'en' | 'es';
  /** Misma página en el otro idioma. En un artículo depende de la traducción. */
  altHref: string;
  /**
   * True en el índice del blog. Sirve para no enlazar "Blog" a la página en la
   * que ya estás, y para que aria-current="page" no mienta en los artículos.
   */
  isIndex?: boolean;
}

const { lang, altHref, isIndex = false } = Astro.props as Props;

const isEs = lang === 'es';
const base = isEs ? '/es' : '';

const content = {
  en: { home: 'Home', blog: 'Blog', premium: 'Premium' },
  es: { home: 'Inicio', blog: 'Blog', premium: 'Premium' },
} as const;

const t = content[lang];

const languages = [
  { code: 'en' as const, flag: '🇺🇸', label: 'EN', href: isEs ? altHref : Astro.url.pathname },
  { code: 'es' as const, flag: '🇪🇸', label: 'ES', href: isEs ? Astro.url.pathname : altHref },
];
---

<header class="blog-nav">
  {/* Único asset del blog que NO va pixelado: el logo es 163x163 (primo, no
      admite division entera) y a 40px con nearest-neighbor se descompone.
      El propio artboard lo marca con image-rendering:auto. */}
  {/* data-astro-reload: sale del blog hacia la landing, que necesita carga
      completa para que arranquen sus scripts de parallax. */}
  <a href={`${base}/`} class="nav-logo" aria-label="Skillion" data-astro-reload>
    <img src={logoUrl.src} alt="Skillion" width="40" height="40" />
  </a>

  <nav class="nav-links" aria-label={t.blog}>
    <a href={`${base}/`} data-astro-reload>{t.home}</a>

    {/* En el índice no es un enlace: llevaría a la página en la que ya estás.
        En un artículo sí, porque el índice es otra página — y por eso el
        aria-current sólo dice "page" cuando de verdad lo es. */}
    {
      isIndex ? (
        <span class="is-active" aria-current="page">{t.blog}</span>
      ) : (
        <a href={`${base}/blog`} class="is-active">{t.blog}</a>
      )
    }

    <a href={`${base}/free-premium`} data-astro-reload>{t.premium}</a>

    <span class="lang-switch">
      {
        languages.map((option) =>
          option.code === lang ? (
            // El idioma activo deja de ser clicable: enlazaba a sí mismo.
            <span class="is-current" aria-current="true" lang={option.code}>
              <span class="flag">{option.flag}</span> {option.label}
            </span>
          ) : (
            <a href={option.href} hreflang={option.code} lang={option.code}>
              <span class="flag">{option.flag}</span> {option.label}
            </a>
          ),
        )
      }
    </span>
  </nav>
</header>

<style>
  .blog-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 32px;
    background: #0b1020;
    border-bottom: 4px solid #3f5da8;
  }

  .nav-logo {
    display: flex;
    flex: none;
  }

  .nav-logo img {
    display: block;
    width: 40px;
    height: 40px;
    image-rendering: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    /* 10px + los 6px de padding de cada enlace ≈ los 20px de separación
       óptica del diseño, pero con el doble de superficie clicable. */
    gap: 10px;
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    line-height: 1;
  }

  /* El texto son 9px: sin padding, el área de clic es una franja de 9px de
     alto y fallarla es lo normal. El padding la sube a ~29px sin mover nada
     de sitio, porque la altura de la barra la marca el logo (40px). */
  .nav-links > a,
  .nav-links > span:not(.lang-switch) {
    padding: 9px 6px;
    color: #8fa6dd;
    text-decoration: none;
    transition: color 0.15s steps(2);
  }

  .nav-links > a:hover,
  .nav-links > a:focus-visible {
    color: #dceafe;
  }

  .nav-links > .is-active {
    color: #ffc53d;
  }

  .lang-switch {
    display: flex;
    gap: 6px;
    margin-left: 6px;
  }

  .lang-switch > a,
  .lang-switch > span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 9px;
    background: #1b2547;
    border: 3px solid #3f5da8;
    color: #8fa6dd;
    text-decoration: none;
  }

  .lang-switch > .is-current {
    background: #ffc53d;
    border-color: #0a0f1f;
    color: #2a1a06;
    /* Es un <span>, así que no hereda el cursor de mano de los enlaces:
       queda claro al pasar por encima que no hay nada que pulsar. */
  }

  .lang-switch > a:hover {
    color: #dceafe;
    border-color: #8fa6dd;
  }

  /* Los emoji de bandera no existen en Press Start 2P: si no se saca de la
     familia, el navegador cambia de fuente y descuadra la caja. */
  .flag {
    font-family:
      'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
    font-size: 11px;
    line-height: 1;
  }

  @media (max-width: 720px) {
    .blog-nav {
      flex-wrap: wrap;
      justify-content: center;
      padding: 14px 16px;
      gap: 12px;
    }

    .nav-links {
      gap: 14px;
      font-size: 8px;
    }
  }
</style>
