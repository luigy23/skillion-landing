---
import { Image } from 'astro:assets';
import swordUrl from '../assets/skillion-sword.svg';
import SiteNav from './SiteNav.astro';
// Iconos pixel art, siempre a múltiplo entero del sprite (o 0,5x el cetro de
// 160) para que no se emborronen.
import coin3Url from '../assets/pixelartAssets/blog/coin3.png'; // 24
import coin2Url from '../assets/pixelartAssets/features/coin2.png'; // 31
import cetroUrl from '../assets/pixelartAssets/features/cetro.png'; // 160
import knightUrl from '../assets/pixelartAssets/rewards/knight.png'; // 76x104
import computerUrl from '../assets/pixelartAssets/blog/computer.png'; // 64
import checklistUrl from '../assets/pixelartAssets/blog/checklist.png'; // 23x22
import starUrl from '../assets/pixelartAssets/blog/star.png'; // 64
import magoUrl from '../assets/pixelartAssets/features/mago.png'; // 60x66
import cloverUrl from '../assets/pixelartAssets/features/clover.png'; // 115x100
import calendarUrl from '../assets/pixelartAssets/blog/calendar.png'; // 48x46
import fireUrl from '../assets/pixelartAssets/blog/fire.png'; // 48
import energyUrl from '../assets/pixelartAssets/blog/energy.png'; // 48

interface Props {
  lang?: 'en' | 'es';
  /** Esta misma página en el otro idioma. */
  altHref: string;
}

const { lang = 'en', altHref } = Astro.props as Props;
const isEs = lang === 'es';

/**
 * El Gremio es lo principal: le mandamos carruseles a cada creador y los sube a
 * cambio de Premium. Se pide por correo: contesta una persona y a los que entran
 * les manda el enlace del bot de Telegram (1-oct-2026). La web no enlaza el bot.
 * Desde el 5-oct-2026 el Gremio llega a creators@, que lleva otra persona;
 * hello@ queda para soporte. El reto de likes se cerró en octubre de 2026 (dejaba
 * poco y le quitaba sitio al Gremio); a quien subió su video antes se le respeta
 * el premio por correo, como dice la FAQ.
 */
const MAIL = 'creators@skillion.app';
const mailSubject = isEs ? 'Quiero entrar al Gremio Skillion' : 'I want to join the Skillion Guild';
const mailBody = isEs
  ? 'Mi TikTok: @\n¿Cuenta nueva o la que ya usas?: \nCorreo de mi cuenta de Skillion: \nPaís: \nPor qué quiero entrar: \n'
  : 'My TikTok: @\nNew account or the one you already use?: \nEmail of my Skillion account: \nCountry: \nWhy I want to join: \n';
const GUILD_MAIL_URL = `mailto:${MAIL}?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;

// Press Start 2P pinta las mayúsculas con tilde como minúsculas ("úNETE"):
// todo lo que va en esa fuente se escribe sin tildes, como la página anterior.
const content = {
  en: {
    badge: 'FREE PREMIUM · LIMITED SPOTS',
    title: 'THE SKILLION GUILD',
    subtitle: 'grow your TikTok',
    lead: 'We send you a ready-to-post carousel Monday to Friday, made for your account with formats that are already working on TikTok. You post it, your account grows and you play with Premium while you keep posting.',
    facts: ['No camera: they are photo carousels', 'Every carousel is only for your account', 'Premium from your first week'],
    cta: 'SEE HOW IT WORKS',
    more: 'Or email us to join',

    qcLabel: 'YOUR WEEK',
    qcCount: '4/5 VIDEOS',
    qcTitle: 'Thursday quest posted',
    qcRewardLabel: 'PREMIUM',
    qcReward: 'On · 4-week streak',
    qcNext: '+120 followers this week',

    perksTitle: 'WHAT PREMIUM UNLOCKS',
    perks: [
      { title: 'Unlimited skills', body: 'The free plan stops at 3 active.' },
      { title: 'Configure with magic', body: 'The AI suggests difficulty, energy and skills for each task.' },
      { title: 'Task of Destiny, no caps', body: 'No limit on accepted tasks or bets.' },
      { title: 'Stats your way', body: 'Pick any date range you want.' },
    ],

    gBadge: 'THREE STEPS',
    gTitle: 'HOW THE GUILD WORKS',
    gLead: 'We send you every carousel with the images and the text to copy. You post it as it is and tap ✅.',
    gSteps: [
      { title: 'Email us', body: 'Send us an email with your details (the list is below). We read them one by one and reply within 48 hours.' },
      { title: 'Your quest arrives', body: 'If you get in, Monday to Friday a carousel ready to post arrives on Telegram, with the images and the text to copy. It is made for your account and nobody else posts it.' },
      { title: 'Play with Premium', body: 'Post it as it is and tap ✅. Finish your first week and Premium turns on, and it stays on every week you complete your 5 videos.' },
    ],

    tgName: 'Skillion Guild',
    tgStatus: 'bot',
    tgQuest: '⚔️ Thursday quest',
    tgQuestBody: 'Your carousel for today. Post it as photos, in this order.',
    tgCover: 'HABITS 10/10 IF YOU STUDY NURSING',
    tgSwipe: 'swipe ▸',
    tgTip: 'Flashcards right before bed',
    tgApp: 'Turn your exams into quests',
    tgCopyLabel: 'Text to copy',
    tgCaption: 'Habits 10/10 if you study nursing #nursingstudent #habits #studytok',
    tgDone: '✅ Posted',
    tgSkip: "Can't today",
    tgProgress: '🔥 4/5 this week. One more and your Premium stays on.',
    tgFigcaption: 'This is what a Guild quest looks like on Telegram.',

    itemBadge: 'GUILD ONLY',
    itemTitle: 'An exclusive item for your character',
    itemBody: 'Guild members get a special item for their Skillion avatar that cannot be earned any other way.',

    pathTitle: 'YOUR PATH IN THE GUILD',
    tierBest: 'TOP',
    path: [
      { when: 'WEEK 1', prize: 'Premium turns on' },
      { when: 'EVERY WEEK', prize: 'It stays on while you complete your 5 videos' },
      { when: 'WEEK 12', prize: '1 FULL YEAR of Premium, yours even if you stop later' },
    ],
    streakTitle: 'STREAK',
    streakEnd: '1 YEAR',
    streakNote: 'Miss your 5 videos in a week and Premium pauses and your streak goes back to zero.',
    lootTitle: 'BONUS LOOT',
    lootLead: 'If one of your videos blows up, you get more. It stacks on top of what you already have.',
    loot: [
      { views: '50,000 VIEWS', prize: '+3 months of Premium' },
      { views: '100,000 VIEWS', prize: '+1 year of Premium' },
    ],

    needsTitle: 'WHAT THE GUILD ASKS FOR',
    needs: [
      'A public TikTok account. If it is new, before your first quest we send you a 5-day warm-up guide.',
      'Your Skillion account, so we know who gets the Premium.',
      'Telegram, which is where your quests arrive.',
      'Keeping the videos up. A deleted video does not count for the week.',
    ],

    applyTitle: 'WE OPEN 10 SPOTS PER COHORT',
    applyLead: 'Every carousel is made for a single account, so we open 10 spots per cohort and choose by hand. Email us at',
    applyLeadPost: 'with:',
    applyItems: ['Your TikTok username', 'Whether it is a new account or the one you already use', 'The email of your Skillion account', 'Your country', 'One line on why you want to join'],
    applyCta: 'EMAIL US TO JOIN',
    applyNote: 'If the current cohort is full, you go on the list for the next one and we let you know.',

    faqTitle: 'QUESTIONS',
    faq: [
      { q: 'What do I get besides Premium?', a: 'A growing account. Every carousel uses a format that is already working on TikTok, and every Monday we tell you how many views and followers you gained.' },
      { q: 'When does Premium turn on?', a: 'When you complete your first week of 5 videos. It stays on every week you complete them, and after 12 weeks in a row a full year is yours.' },
      { q: 'Do I have to be in the videos?', a: 'No. They are photo carousels with text, and your face is never in them.' },
      { q: 'Do I need lots of followers?', a: 'No. TikTok shows every video to people who do not follow you, and we have had carousels reach thousands of views on accounts with fewer than 20 followers.' },
      { q: 'Can I change the photos or the text?', a: 'Post it as it is. That is how we learn what works and make your next quest better.' },
      { q: 'What if I cannot make it one week?', a: 'Your Guild Premium pauses and your streak goes back to zero. As soon as you complete another week, it turns back on.' },
      { q: 'What happened to the likes challenge?', a: 'We closed it in October 2026 to focus on the Guild. If you posted your video before that, email creators@skillion.app with a screenshot of the likes and the link, and we will give you what we promised.' },
    ],

    finalTitle: 'JOIN THE GUILD',
    finalLead: 'Email us today. If you get in, your first quest arrives on Telegram and your Premium turns on when you complete your first week.',
    finalCta: 'EMAIL US TO JOIN',

    downloadTitle: "Don't have Skillion yet?",
    downloadBody: 'Download it and start building your character.',
    play: 'GOOGLE PLAY',
    appStore: 'APP STORE',
  },
  es: {
    badge: 'PREMIUM GRATIS · PLAZAS LIMITADAS',
    title: 'EL GREMIO SKILLION',
    subtitle: 'haz crecer tu TikTok',
    lead: 'Te mandamos un carrusel listo de lunes a viernes, hecho para tu cuenta con formatos que ya funcionan en TikTok. Tú lo subes, tu cuenta crece y juegas con Premium mientras publiques.',
    facts: ['Sin salir en cámara: son carruseles de fotos', 'Cada carrusel es solo para tu cuenta', 'Premium desde tu primera semana'],
    cta: 'VER COMO FUNCIONA',
    more: 'O escríbenos ya para entrar',

    qcLabel: 'TU SEMANA',
    qcCount: '4/5 VIDEOS',
    qcTitle: 'Misión del jueves publicada',
    qcRewardLabel: 'PREMIUM',
    qcReward: 'Activo · racha de 4 semanas',
    qcNext: '+120 seguidores esta semana',

    perksTitle: 'LO QUE DESBLOQUEA PREMIUM',
    perks: [
      { title: 'Skills sin límite', body: 'El plan gratis se queda en 3 activas.' },
      { title: 'Configurar con magia', body: 'La IA propone dificultad, energía y habilidades de cada tarea.' },
      { title: 'Máquina del destino sin tope', body: 'Sin límite de tareas aceptadas ni de apuesta.' },
      { title: 'Estadísticas a tu medida', body: 'Elige el rango de fechas que quieras.' },
    ],

    gBadge: 'TRES PASOS',
    gTitle: 'ASI FUNCIONA EL GREMIO',
    gLead: 'Te mandamos cada carrusel con las imágenes y el texto para copiar. Tú lo subes tal cual y tocas ✅.',
    gSteps: [
      { title: 'Escríbenos', body: 'Mándanos un correo con tus datos (abajo tienes la lista). Los leemos uno por uno y te contestamos en menos de 48 horas.' },
      { title: 'Te llega la misión', body: 'Si entras, de lunes a viernes te llega por Telegram un carrusel listo para subir, con las imágenes y el texto para copiar. Está hecho para tu cuenta y nadie más lo sube.' },
      { title: 'Juegas con Premium', body: 'Lo publicas tal cual y tocas ✅. Al completar tu primera semana se activa tu Premium, y sigue activo cada semana que completes tus 5 videos.' },
    ],

    tgName: 'Gremio Skillion',
    tgStatus: 'bot',
    tgQuest: '⚔️ Misión del jueves',
    tgQuestBody: 'Tu carrusel de hoy. Súbelo como fotos, en este orden.',
    tgCover: 'HÁBITOS 10/10 SI ESTUDIAS MEDICINA',
    tgSwipe: 'desliza ▸',
    tgTip: 'Repasar con tarjetas antes de dormir',
    tgApp: 'Convertir tus parciales en misiones',
    tgCopyLabel: 'Texto para copiar',
    tgCaption: 'Hábitos 10/10 si estudias medicina #medicina #habitos #estudiante',
    tgDone: '✅ Publicado',
    tgSkip: 'Hoy no puedo',
    tgProgress: '🔥 4/5 esta semana. Con uno más mantienes tu Premium.',
    tgFigcaption: 'Así se ve una misión del Gremio en Telegram.',

    itemBadge: 'SOLO DEL GREMIO',
    itemTitle: 'Un objeto exclusivo para tu personaje',
    itemBody: 'Los miembros del Gremio reciben un objeto especial para su avatar de Skillion que no se consigue de ninguna otra forma.',

    pathTitle: 'TU CAMINO EN EL GREMIO',
    tierBest: 'TOP',
    path: [
      { when: 'SEMANA 1', prize: 'Se activa tu Premium' },
      { when: 'CADA SEMANA', prize: 'Sigue activo mientras completes tus 5 videos' },
      { when: 'SEMANA 12', prize: '1 AÑO COMPLETO de Premium, tuyo aunque después lo dejes' },
    ],
    streakTitle: 'RACHA',
    streakEnd: '1 AÑO',
    streakNote: 'Si una semana no completas tus 5 videos, tu Premium se pausa y la racha vuelve a cero.',
    lootTitle: 'BOTIN EXTRA',
    lootLead: 'Si uno de tus videos explota, te llevas más. Se suma a lo que ya tengas.',
    loot: [
      { views: '50.000 VISTAS', prize: '+3 meses de Premium' },
      { views: '100.000 VISTAS', prize: '+1 año de Premium' },
    ],

    needsTitle: 'QUE PIDE EL GREMIO',
    needs: [
      'Una cuenta de TikTok pública. Si es nueva, antes de tu primera misión te pasamos una guía para calentarla en 5 días.',
      'Tu cuenta de Skillion, para saber a quién activarle el Premium.',
      'Telegram, que es por donde te llegan las misiones.',
      'Dejar los videos publicados. Un video borrado no cuenta para la semana.',
    ],

    applyTitle: 'ABRIMOS 10 PLAZAS POR COHORTE',
    applyLead: 'Cada carrusel se hace para una sola cuenta, así que abrimos 10 plazas por cohorte y elegimos a mano. Escríbenos a',
    applyLeadPost: 'con:',
    applyItems: ['Tu usuario de TikTok', 'Si es una cuenta nueva o la que ya usas', 'El correo de tu cuenta de Skillion', 'Tu país', 'En una línea, por qué quieres entrar'],
    applyCta: 'ESCRIBIRNOS PARA ENTRAR',
    applyNote: 'Si la cohorte de ahora está llena, quedas en la lista de la siguiente y te avisamos.',

    faqTitle: 'PREGUNTAS',
    faq: [
      { q: '¿Qué gano además del Premium?', a: 'Una cuenta que crece. Cada carrusel usa un formato que ya está funcionando en TikTok, y cada lunes te contamos cuántas vistas y seguidores ganaste.' },
      { q: '¿Cuándo se activa el Premium?', a: 'Al completar tu primera semana de 5 videos. Sigue activo cada semana que los completes, y a las 12 semanas seguidas es tuyo un año entero.' },
      { q: '¿Tengo que salir en los videos?', a: 'No. Son carruseles de fotos con texto y tu cara no aparece en ninguno.' },
      { q: '¿Necesito muchos seguidores?', a: 'No. TikTok enseña cada video a gente que no te sigue, y hemos tenido carruseles con miles de vistas en cuentas de menos de 20 seguidores.' },
      { q: '¿Puedo cambiar las fotos o el texto?', a: 'Súbelo tal cual. Así sabemos qué funciona y tu próxima misión sale mejor.' },
      { q: '¿Qué pasa si una semana no puedo?', a: 'Tu Premium del Gremio se pausa y la racha vuelve a cero. En cuanto completes otra semana, se activa de nuevo.' },
      { q: '¿Qué pasó con el reto de likes?', a: 'Lo cerramos en octubre de 2026 para dedicarnos al Gremio. Si subiste tu video antes, escríbenos a creators@skillion.app con la captura de los likes y el enlace, y te damos lo prometido.' },
    ],

    finalTitle: 'ENTRA AL GREMIO',
    finalLead: 'Escríbenos hoy. Si entras, tu primera misión te llega por Telegram y tu Premium se activa al completar la primera semana.',
    finalCta: 'ESCRIBIRNOS PARA ENTRAR',

    downloadTitle: '¿Aún no tienes Skillion?',
    downloadBody: 'Descárgala y empieza a construir tu personaje.',
    play: 'GOOGLE PLAY',
    appStore: 'APP STORE',
  },
} as const;

const t = content[lang];

const tierIcons = [
  { src: coin3Url.src, size: 48, tone: 'bronze' },
  { src: coin2Url.src, size: 62, tone: 'silver' },
  { src: cetroUrl.src, size: 80, tone: 'gold' },
];

const perkIcons = [
  { src: starUrl.src, w: 48, h: 48 },
  { src: magoUrl.src, w: 45, h: 50 },
  { src: cloverUrl.src, w: 58, h: 50 },
  { src: calendarUrl.src, w: 48, h: 46 },
];

const gStepIcons = [
  { src: knightUrl.src, w: 38, h: 52 },
  { src: computerUrl.src, w: 48, h: 48 },
  { src: coin2Url.src, w: 62, h: 62 },
];

const lootIcons = [energyUrl.src, fireUrl.src];

// Barra de la tarjeta del hero: los 5 videos de la semana, 4 hechos.
const weekMarks = [1, 2, 3, 4, 5].map((n) => ({ at: n * 20, label: n, done: n <= 4 }));
const weekFill = 80;

const streakWeeks = Array.from({ length: 12 }, (_, i) => i);
---

<SiteNav lang={lang} altHref={altHref} section="premium" isCurrent />

<main class="guild">
  <!-- ============ HERO: el Gremio ============ -->
  <section class="g-hero">
    <div class="g-hero-inner">
      <div class="g-hero-copy">
        <span class="g-badge">{t.badge}</span>
        <h1 class="g-h1">
          {t.title}
          <span class="g-h1-sub">{t.subtitle}</span>
        </h1>
        <p class="g-lead">{t.lead}</p>

        <ul class="g-facts">
          {t.facts.map((fact) => <li>{fact}</li>)}
        </ul>

        <div class="g-ctas">
          <a href="#gremio" class="pixel-cta pixel-cta--gold g-cta-big">{t.cta}</a>
          <a href={GUILD_MAIL_URL} class="g-link" data-cta="gremio_correo_hero">{t.more} <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <!-- Tarjeta de la semana de un creador: 4 de 5 videos, Premium activo y
           lo que creció su cuenta. Decorado: lo que dice está explicado en
           texto más abajo. -->
      <div class="g-hero-art" aria-hidden="true">
        <Image src={swordUrl} alt="" width={44} height={64} class="qc-sword" />
        <div class="qc">
          <div class="qc-top">
            <span class="qc-label">{t.qcLabel}</span>
            <span class="qc-count">{t.qcCount}</span>
          </div>
          <p class="qc-title">
            <img src={starUrl.src} alt="" width="32" height="32" class="pixel-img" />
            {t.qcTitle}
          </p>
          <div class="lk">
            <div class="lk-bar"><span class="lk-fill" style={`--fill:${weekFill}%`}></span></div>
            <ol class="lk-marks">
              {weekMarks.map((mark) => (
                <li class={mark.done ? 'is-done' : ''} style={`--p:${mark.at}%`}>{mark.label}</li>
              ))}
            </ol>
          </div>
          <div class="qc-reward">
            <img src={coin2Url.src} alt="" width="31" height="31" class="pixel-img" />
            <span class="qc-reward-label">{t.qcRewardLabel}</span>
            <span class="qc-reward-value">{t.qcReward}</span>
          </div>
          <div class="qc-streak">
            <img src={fireUrl.src} alt="" width="24" height="24" class="pixel-img" />
            {t.qcNext}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ COMO FUNCIONA EL GREMIO ============ -->
  <section id="gremio" class="g-section">
    <header class="g-head" data-reveal>
      <span class="g-badge g-badge--mint">{t.gBadge}</span>
      <h2 class="g-h2 g-h2--big">{t.gTitle}</h2>
      <p class="g-sublead">{t.gLead}</p>
    </header>

    <div class="how-grid">
      <ol class="how-steps">
        {t.gSteps.map((step, i) => (
          <li class="how-step" data-reveal style={`--d:${i}`}>
            <div class="how-icon">
              <img src={gStepIcons[i].src} alt="" width={gStepIcons[i].w} height={gStepIcons[i].h} class="pixel-img" loading="lazy" decoding="async" />
            </div>
            <div class="how-text">
              <span class="how-num">0{i + 1}</span>
              <h3 class="how-title">{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <figure class="tg" data-reveal>
        <div class="tg-phone">
          <div class="tg-bar">
            <span class="tg-back" aria-hidden="true">‹</span>
            <span class="tg-avatar"><Image src={swordUrl} alt="" width={14} height={20} /></span>
            <span class="tg-who">
              <strong>{t.tgName}</strong>
              <span>{t.tgStatus}</span>
            </span>
          </div>

          <div class="tg-chat">
            <div class="tg-msg">
              <p class="tg-msg-title">{t.tgQuest}</p>
              <p>{t.tgQuestBody}</p>
            </div>

            <div class="tg-album">
              <div class="sl sl-cover">
                <span class="sl-cover-title">{t.tgCover}</span>
                <span class="sl-swipe">{t.tgSwipe}</span>
              </div>
              <div class="sl sl-tip">
                <span class="sl-num">1</span>
                <span class="sl-text">{t.tgTip}</span>
                <span class="sl-meter"><i></i><i></i><i></i><i></i><i></i></span>
              </div>
              <div class="sl sl-app">
                <span class="sl-text">{t.tgApp}</span>
                <span class="sl-phone"><i></i><i></i><i></i></span>
              </div>
            </div>

            <div class="tg-msg tg-msg--copy">
              <span class="tg-copy-label">{t.tgCopyLabel}</span>
              <span class="tg-code">{t.tgCaption}</span>
            </div>

            <div class="tg-buttons">
              <span class="tg-btn">{t.tgDone}</span>
              <span class="tg-btn">{t.tgSkip}</span>
            </div>

            <div class="tg-msg tg-msg--note">{t.tgProgress}</div>
          </div>
        </div>
        <figcaption>{t.tgFigcaption}</figcaption>
      </figure>
    </div>

    <div class="item" data-reveal>
      <div class="item-box" aria-hidden="true"><span>?</span></div>
      <div class="item-text">
        <span class="item-badge">{t.itemBadge}</span>
        <h3 class="item-title">{t.itemTitle}</h3>
        <p>{t.itemBody}</p>
      </div>
    </div>

    <h3 class="g-h3" data-reveal>{t.pathTitle}</h3>
    <ol class="tier-grid">
      {t.path.map((tier, i) => (
        <li class={`tier-card tier-card--${tierIcons[i].tone}`} data-reveal style={`--d:${i}`}>
          {i === 2 && <span class="tier-flag">{t.tierBest}</span>}
          <div class="tier-icon" style={`height:${tierIcons[i].size}px`}>
            <img src={tierIcons[i].src} alt="" width={tierIcons[i].size} height={tierIcons[i].size} class="pixel-img" loading="lazy" decoding="async" />
          </div>
          <span class="tier-when">{tier.when}</span>
          <span class="tier-prize">{tier.prize}</span>
        </li>
      ))}
    </ol>

    <div class="streak" data-reveal>
      <div class="streak-head">
        <img src={fireUrl.src} alt="" width="24" height="24" class="pixel-img" />
        <span class="streak-title">{t.streakTitle}</span>
      </div>
      <ol class="streak-track" aria-hidden="true">
        {streakWeeks.map((w) => (
          <li class="streak-cell" style={`--i:${w}`}><span>{w + 1}</span></li>
        ))}
        <li class="streak-goal" style="--i:12">
          <img src={cetroUrl.src} alt="" width="40" height="40" class="pixel-img" />
          <span>{t.streakEnd}</span>
        </li>
      </ol>
      <p class="streak-note">{t.streakNote}</p>
    </div>

    <div class="loot" data-reveal>
      <h3 class="g-h3 g-h3--gold">{t.lootTitle}</h3>
      <p class="g-sublead g-sublead--tight">{t.lootLead}</p>
      <ul class="loot-grid">
        {t.loot.map((drop, i) => (
          <li class="loot-card">
            <img src={lootIcons[i]} alt="" width="48" height="48" class="pixel-img" loading="lazy" decoding="async" />
            <span class="loot-views">{drop.views}</span>
            <span class="loot-prize">{drop.prize}</span>
          </li>
        ))}
      </ul>
    </div>

    <h3 class="g-h3" data-reveal>{t.perksTitle}</h3>
    <ul class="perk-grid">
      {t.perks.map((perk, i) => (
        <li class="perk" data-reveal style={`--d:${i}`}>
          <div class="perk-icon">
            <img src={perkIcons[i].src} alt="" width={perkIcons[i].w} height={perkIcons[i].h} class="pixel-img" loading="lazy" decoding="async" />
          </div>
          <h4 class="perk-title">{perk.title}</h4>
          <p>{perk.body}</p>
        </li>
      ))}
    </ul>

    <h3 class="g-h3" data-reveal>{t.needsTitle}</h3>
    <ul class="needs" data-reveal>
      {t.needs.map((need) => (
        <li>
          <span class="needs-check" aria-hidden="true"></span>
          <span>{need}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ SOLICITUD AL GREMIO (por correo) ============ -->
  <section class="g-section g-section--alt">
    <div class="g-wrap spots" data-reveal>
      <h2 class="g-h2">{t.applyTitle}</h2>
      <p class="g-sublead">
        {t.applyLead} <a href={`mailto:${MAIL}`} class="g-mail">{MAIL}</a> {t.applyLeadPost}
      </p>
      <ul class="apply-list">
        {t.applyItems.map((item) => <li>{item}</li>)}
      </ul>
      <a href={GUILD_MAIL_URL} class="pixel-cta pixel-cta--gold g-cta-big" data-cta="gremio_correo">
        {t.applyCta}
      </a>
      <p class="apply-note">{t.applyNote}</p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="g-section">
    <header class="g-head" data-reveal>
      <h2 class="g-h2">{t.faqTitle}</h2>
    </header>
    <div class="faq" data-reveal>
      {t.faq.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ============ CIERRE ============ -->
  <section class="g-final">
    <div class="g-final-inner" data-reveal>
      <Image src={swordUrl} alt="" width={50} height={72} class="g-final-sword" />
      <h2 class="g-h2">{t.finalTitle}</h2>
      <p class="g-sublead">{t.finalLead}</p>
      <a href={GUILD_MAIL_URL} class="pixel-cta pixel-cta--gold g-cta-big" data-cta="gremio_correo_final">{t.finalCta}</a>
    </div>

    <div class="g-download">
      <h3 class="g-download-title">{t.downloadTitle}</h3>
      <p>{t.downloadBody}</p>
      <div class="store-row">
        <a href="https://play.google.com/store/apps/details?id=app.skillion&pcampaignid=web_share" target="_blank" rel="noopener noreferrer" class="pixel-cta pixel-cta--mint">
          {t.play}
        </a>
        <a href="https://apps.apple.com/app/skillion-gamify-your-life/id6752905262" target="_blank" rel="noopener noreferrer" class="pixel-cta pixel-cta--mint">
          {t.appStore}
        </a>
      </div>
    </div>
  </section>
</main>

<style>
  .guild {
    --bg: #0f1526;
    --bg-deep: #0b1020;
    --ink: #0a0f1f;
    --panel: #1b2547;
    --panel-2: #141b32;
    --line: #243157;
    --blue: #3f5da8;
    --text: #c9d6f5;
    --muted: #8fa6dd;
    --gold: #ffc53d;
    --gold-light: #ffe6a0;
    --gold-dark: #c98a12;
    --mint: #8fe3da;
    --bronze: #a9784a;
    --pixel: 'Press Start 2P', 'Courier New', monospace;

    background: var(--bg);
    color: var(--text);
    font-family: 'Nunito', 'Poppins', sans-serif;
    overflow-x: clip;
  }

  .pixel-img {
    height: auto;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  /* ---------- BOTONES ---------- */
  .pixel-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 20px;
    border: 4px solid var(--ink);
    font-family: var(--pixel);
    font-size: clamp(9px, 1.4vw, 11px);
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .pixel-cta--gold {
    background: var(--gold);
    color: #2a1a06;
    box-shadow:
      inset -4px -4px 0 0 var(--gold-dark),
      inset 4px 4px 0 0 var(--gold-light),
      6px 6px 0 0 rgba(5, 8, 18, 0.45);
  }

  .pixel-cta--mint {
    background: var(--mint);
    color: #0a2b28;
    box-shadow:
      inset -4px -4px 0 0 #3f8f86,
      inset 4px 4px 0 0 #d5fbf6,
      6px 6px 0 0 rgba(5, 8, 18, 0.45);
  }

  .pixel-cta:hover {
    transform: translate(-2px, -2px);
  }

  .pixel-cta:active {
    transform: translate(2px, 2px);
  }

  .pixel-cta:focus-visible,
  .g-link:focus-visible,
  .faq-item summary:focus-visible {
    outline: 3px solid var(--mint);
    outline-offset: 3px;
  }

  .g-cta-big {
    padding: 18px 26px;
    font-size: clamp(10px, 1.6vw, 13px);
  }

  /* ---------- HERO ---------- */
  .g-hero {
    position: relative;
    padding: 56px 20px 72px;
    background:
      radial-gradient(60% 50% at 78% 30%, rgba(255, 197, 61, 0.12), transparent 70%),
      linear-gradient(#141b32 0%, var(--bg) 100%);
    border-bottom: 4px solid var(--panel);
  }

  .g-hero-inner {
    display: grid;
    gap: 44px;
    max-width: 68rem;
    margin: 0 auto;
    align-items: center;
  }

  .g-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .g-badge {
    padding: 8px 12px;
    background: var(--gold);
    color: #2a1a06;
    border: 3px solid var(--ink);
    font-family: var(--pixel);
    font-size: 9px;
    line-height: 1.5;
  }

  .g-h1 {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    font-family: var(--pixel);
    font-size: clamp(24px, 5.4vw, 44px);
    font-weight: 400;
    line-height: 1.25;
    color: var(--gold-light);
    text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.45);
  }

  .g-h1-sub {
    font-family: 'Nunito', sans-serif;
    font-size: clamp(20px, 3.4vw, 30px);
    font-weight: 900;
    line-height: 1.2;
    color: var(--mint);
    text-shadow: none;
  }

  .g-lead {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(17px, 2.2vw, 20px);
    font-weight: 700;
    line-height: 1.55;
    color: var(--text);
    text-wrap: pretty;
  }

  .g-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 4px 0 6px;
    padding: 0;
    list-style: none;
  }

  .g-facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: var(--panel-2);
    border: 3px solid var(--line);
    font-size: 14px;
    font-weight: 800;
    color: var(--text);
  }

  .g-facts li::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--mint);
    box-shadow: 0 0 0 2px var(--ink);
  }

  .g-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
  }

  .g-link {
    font-size: 16px;
    font-weight: 800;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .g-link:hover {
    color: var(--gold-light);
  }

  /* ---------- TARJETA DE MISION ---------- */
  .g-hero-art {
    position: relative;
    justify-self: center;
    width: min(100%, 360px);
    padding-top: 18px;
  }

  .qc-sword {
    position: absolute;
    top: -14px;
    left: -12px;
    z-index: 2;
    width: 44px;
    height: auto;
    animation: g-float 3s ease-in-out infinite;
  }

  .qc {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 22px 20px 20px;
    background: var(--panel);
    border: 4px solid var(--ink);
    box-shadow:
      inset 0 0 0 4px var(--gold),
      10px 10px 0 0 rgba(5, 8, 18, 0.5);
    transform: rotate(-1.5deg);
  }

  .qc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .qc-label,
  .qc-count {
    font-family: var(--pixel);
    font-size: 10px;
    line-height: 1.4;
    color: var(--gold);
  }

  .qc-count {
    color: var(--mint);
  }

  .qc-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: 18px;
    font-weight: 900;
    line-height: 1.3;
    color: #fff;
  }

  /* Barra de la semana: los 5 videos */
  .lk {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .lk-bar {
    position: relative;
    height: 24px;
    background: var(--panel-2);
    border: 3px solid var(--ink);
    box-shadow: inset 0 0 0 3px var(--line);
  }

  .lk-fill {
    position: absolute;
    inset: 3px auto 3px 3px;
    width: calc(var(--fill, 63%) - 6px);
    background: repeating-linear-gradient(90deg, #ff5d7a 0 10px, #ff8aa0 10px 20px);
    animation: g-fill 1.4s steps(14, end) 0.4s both;
  }

  .lk-marks {
    position: relative;
    height: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lk-marks li {
    position: absolute;
    left: var(--p);
    transform: translateX(-50%);
    font-family: var(--pixel);
    font-size: 9px;
    line-height: 1.4;
    color: var(--muted);
  }

  .lk-marks li:last-child {
    transform: translateX(-100%);
  }

  .lk-marks li.is-done {
    color: #ff8aa0;
  }

  .qc-reward {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 12px;
    row-gap: 4px;
    align-items: center;
    padding: 12px 14px;
    background: var(--panel-2);
    border: 3px solid var(--line);
  }

  .qc-reward img {
    grid-row: span 2;
  }

  .qc-reward-label {
    font-family: var(--pixel);
    font-size: 8px;
    color: var(--muted);
  }

  .qc-reward-value {
    font-size: 16px;
    font-weight: 900;
    color: var(--gold-light);
  }

  .qc-streak {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 800;
    color: var(--text);
  }

  @keyframes g-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes g-fill {
    from {
      width: 0;
    }
  }

  .g-badge--mint {
    display: inline-block;
    margin-bottom: 18px;
    background: var(--mint);
    color: #0a2b28;
  }

  /* ---------- SECCIONES ---------- */
  .g-section {
    max-width: 68rem;
    margin: 0 auto;
    padding: 72px 20px;
  }

  .g-section--alt {
    max-width: none;
    background: var(--bg-deep);
    border-block: 4px solid var(--panel);
  }

  .g-wrap {
    max-width: 68rem;
    margin: 0 auto;
  }

  .g-head {
    margin-bottom: 40px;
    text-align: center;
  }

  .g-h2 {
    margin: 0 0 14px;
    font-family: var(--pixel);
    font-size: clamp(16px, 3vw, 24px);
    font-weight: 400;
    line-height: 1.6;
    color: var(--gold);
    text-align: center;
    text-wrap: balance;
  }

  .g-h2--big {
    font-size: clamp(20px, 4vw, 32px);
    color: var(--gold-light);
  }

  .g-h2--small {
    font-size: clamp(13px, 2.2vw, 18px);
  }

  .g-h3 {
    margin: 64px 0 24px;
    font-family: var(--pixel);
    font-size: clamp(11px, 1.8vw, 14px);
    font-weight: 400;
    line-height: 1.6;
    color: var(--gold-light);
    text-align: center;
  }

  .g-h3--gold {
    margin-top: 0;
    color: var(--gold);
  }

  .g-sublead {
    margin: 0 auto;
    max-width: 40rem;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.6;
    color: var(--muted);
    text-align: center;
    text-wrap: pretty;
  }

  .g-sublead--tight {
    margin-bottom: 24px;
  }

  /* ---------- COMO FUNCIONA ---------- */
  .how-grid {
    display: grid;
    gap: 48px;
    align-items: start;
  }

  .how-steps {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Camino de puntos entre pasos */
  .how-steps::before {
    content: '';
    position: absolute;
    top: 40px;
    bottom: 40px;
    left: 39px;
    width: 4px;
    background: repeating-linear-gradient(to bottom, var(--blue) 0 8px, transparent 8px 16px);
  }

  .how-step {
    position: relative;
    display: grid;
    grid-template-columns: 82px 1fr;
    gap: 18px;
    align-items: start;
    padding: 18px 20px 20px 0;
  }

  .how-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 82px;
    height: 82px;
    background: var(--panel);
    border: 4px solid var(--ink);
    box-shadow: inset 0 0 0 4px var(--blue), 6px 6px 0 0 rgba(5, 8, 18, 0.45);
  }

  .how-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 4px;
  }

  .how-num {
    font-family: var(--pixel);
    font-size: 11px;
    color: var(--blue);
  }

  .how-title {
    margin: 0;
    font-size: 21px;
    font-weight: 900;
    line-height: 1.3;
    color: var(--gold-light);
  }

  .how-text p {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.6;
    color: var(--text);
    text-wrap: pretty;
  }

  /* ---------- TELEGRAM ---------- */
  .tg {
    justify-self: center;
    width: min(100%, 340px);
    margin: 0;
  }

  .tg figcaption {
    margin-top: 16px;
    font-size: 14px;
    font-weight: 700;
    color: var(--muted);
    text-align: center;
  }

  .tg-phone {
    overflow: hidden;
    background: #0e1621;
    border: 10px solid #05070d;
    border-radius: 36px;
    box-shadow:
      0 0 0 2px #2a3550,
      14px 14px 0 0 rgba(5, 8, 18, 0.55);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .tg-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 14px 10px;
    background: #17212b;
    border-bottom: 1px solid #0b1118;
  }

  .tg-back {
    font-size: 26px;
    line-height: 1;
    color: #6ab3f3;
  }

  .tg-avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    background: linear-gradient(135deg, #3f5da8, #1b2547);
    border-radius: 50%;
  }

  .tg-who {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .tg-who strong {
    font-size: 14px;
    color: #fff;
  }

  .tg-who span {
    font-size: 12px;
    color: #708499;
  }

  .tg-chat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 14px 10px 16px;
    background:
      radial-gradient(circle at 20% 20%, rgba(106, 179, 243, 0.06), transparent 40%),
      #0e1621;
  }

  .tg-msg {
    max-width: 92%;
    padding: 8px 11px 9px;
    background: #182533;
    border-radius: 14px 14px 14px 4px;
    font-size: 13px;
    line-height: 1.4;
    color: #e9eef4;
  }

  .tg-msg p {
    margin: 0;
  }

  .tg-msg-title {
    margin-bottom: 2px !important;
    font-weight: 700;
    color: #fff;
  }

  .tg-album {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 3px;
    width: 92%;
    overflow: hidden;
    border-radius: 14px 14px 14px 4px;
  }

  .sl {
    position: relative;
    overflow: hidden;
    min-height: 0;
    color: #fff;
    background: #0b0907;
  }

  .sl-cover {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    padding: 12px 10px;
    text-align: center;
    background:
      radial-gradient(70% 45% at 82% 34%, rgba(255, 196, 120, 0.55), transparent 70%),
      radial-gradient(90% 60% at 15% 100%, rgba(95, 70, 45, 0.7), transparent 70%),
      linear-gradient(165deg, #2c231a, #0b0907 75%);
  }

  .sl-cover-title {
    font-family: 'Bodoni 72', Didot, 'Playfair Display', Georgia, serif;
    font-size: 13px;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }

  .sl-swipe {
    position: absolute;
    bottom: 8px;
    font-size: 8px;
    opacity: 0.85;
  }

  .sl-tip,
  .sl-app {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 8px;
    background:
      radial-gradient(80% 60% at 70% 20%, rgba(120, 140, 170, 0.25), transparent 70%),
      linear-gradient(160deg, #1a1d24, #08090c);
  }

  .sl-num {
    font-family: 'Bodoni 72', Didot, Georgia, serif;
    font-size: 22px;
    line-height: 1;
  }

  .sl-text {
    font-family: 'Bodoni 72', Didot, Georgia, serif;
    font-size: 9.5px;
    line-height: 1.2;
  }

  .sl-meter {
    display: flex;
    gap: 2px;
  }

  .sl-meter i {
    width: 7px;
    height: 7px;
    background: #f2a33a;
  }

  .sl-phone {
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-self: center;
    width: 46%;
    padding: 6px 5px;
    background: #222;
    border: 2px solid #3a3a3a;
    border-radius: 7px;
  }

  .sl-phone i {
    height: 5px;
    background: linear-gradient(to right, #4cd964 60%, #555 60%);
    border-radius: 2px;
  }

  .sl-phone i:nth-child(2) {
    background: linear-gradient(to right, #4cd964 40%, #555 40%);
  }

  .sl-phone i:nth-child(3) {
    background: linear-gradient(to right, #4cd964 75%, #555 75%);
  }

  .tg-msg--copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tg-copy-label {
    font-size: 11px;
    font-weight: 700;
    color: #6ab3f3;
  }

  .tg-code {
    padding: 6px 8px;
    background: #0e1621;
    border-radius: 6px;
    font-family: ui-monospace, Menlo, monospace;
    font-size: 11px;
    line-height: 1.45;
    color: #c6e0f8;
  }

  .tg-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    width: 92%;
  }

  .tg-btn {
    padding: 8px 6px;
    background: rgba(24, 37, 51, 0.85);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    text-align: center;
  }

  .tg-msg--note {
    margin-top: 6px;
    font-weight: 600;
  }

  /* ---------- PREMIUM ---------- */
  .perk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .perk {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 20px;
    background: var(--panel);
    border: 4px solid var(--ink);
    box-shadow: 6px 6px 0 0 rgba(5, 8, 18, 0.45);
  }

  .perk-icon {
    display: flex;
    align-items: flex-end;
    height: 52px;
    margin-bottom: 6px;
  }

  .perk-title {
    margin: 0;
    font-size: 18px;
    font-weight: 900;
    line-height: 1.3;
    color: var(--gold-light);
  }

  .perk p {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ---------- ESCALERA ---------- */
  .tier-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tier-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 30px 20px 26px;
    text-align: center;
    background: var(--panel);
    border: 4px solid var(--ink);
  }

  .tier-card--bronze {
