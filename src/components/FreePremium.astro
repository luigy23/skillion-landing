  }

  .tier-prize {
    font-size: 16px;
    font-weight: 800;
    line-height: 1.45;
    color: var(--text);
    text-wrap: balance;
  }

  /* ---------- OBJETO EXCLUSIVO DEL GREMIO ----------
     Caja misteriosa con "?": el objeto no se enseña. */
  .item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    align-items: center;
    max-width: 46rem;
    margin: 64px auto 0;
    padding: 24px;
    background: linear-gradient(135deg, #2a1f52, var(--panel));
    border: 4px solid var(--ink);
    box-shadow:
      inset 0 0 0 4px #b48cff,
      10px 10px 0 0 rgba(5, 8, 18, 0.5);
