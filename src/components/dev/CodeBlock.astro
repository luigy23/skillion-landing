---
/** Un bloque de código con su barra: qué es y el botón de copiar. */
interface Props {
  label: string;
  code: string;
  copy: string;
  copied: string;
}
const { label, code, copy, copied } = Astro.props;
---
<div class="code">
  <div class="code__bar"><span>{label}</span><button type="button" class="copy" data-copied={copied}>{copy}</button></div>
  <pre><code>{code}</code></pre>
</div>
